<Window x:Class="MCL.VersionDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认删除版本" Width="540" SizeToContent="Height" MaxHeight="680" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="16" Padding="24,20,24,22"
            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource HeroBorderBrush}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource DialogShadowColor}" ShadowDepth="3" BlurRadius="22" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel LastChildFill="True" Margin="0,0,0,14">
                        <Button DockPanel.Dock="Right" Padding="9" Background="{DynamicResource PanelBrush}" VerticalAlignment="Top"
                                Click="Cancel_Click" AutomationProperties.Name="取消删除" ToolTip="取消删除">
                            <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource MutedBrush}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Button>
                        <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,12,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="将处理以下版本文件夹：" Style="{StaticResource MutedText}" FontSize="12" />
                    <Border Style="{StaticResource Card}" Padding="14" Margin="0,8,0,14"><TextBlock Text="{Binding DirectoryPath}" FontSize="12" TextWrapping="Wrap" /></Border>
                    <Border Background="{DynamicResource SoftAccentBrush}" Padding="14" CornerRadius="10"><TextBlock Text="{Binding DataNotice}" FontSize="13" TextWrapping="Wrap" LineHeight="22" Foreground="{DynamicResource AccentTextBrush}" /></Border>
                    <TextBlock Text="删除范围仅为上面的版本文件夹，可在 Windows 回收站恢复。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0" />
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="1" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,18,0,0" Padding="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelDeleteButton" Content="取消" IsCancel="True" IsDefault="True" Click="Cancel_Click"
                            Background="{DynamicResource PanelBrush}" MinWidth="86" />
                    <Button x:Name="ConfirmDeleteButton" Content="移入回收站" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" Margin="10,0,0,0" Padding="18,11" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
