<Window x:Class="MCL.VersionDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认删除版本" Width="540" SizeToContent="Height" MaxHeight="680" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI">
    <Border Padding="26" Background="{StaticResource BackgroundBrush}"><Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,15" />
                <TextBlock Text="将处理以下版本文件夹：" Style="{StaticResource MutedText}" FontSize="12" />
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,9,0,15"><TextBlock Text="{Binding DirectoryPath}" FontSize="12" TextWrapping="Wrap" /></Border>
                <Border Background="{StaticResource SoftAccentBrush}" Padding="14" CornerRadius="8"><TextBlock Text="{Binding DataNotice}" FontSize="13" TextWrapping="Wrap" LineHeight="23" Foreground="{StaticResource AccentTextBrush}" /></Border>
                <TextBlock Text="删除范围仅为上面的版本文件夹，可在 Windows 回收站恢复。" Style="{StaticResource MutedText}" FontSize="12" Margin="0,13,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelDeleteButton" Content="取消" IsCancel="True" IsDefault="True" Click="Cancel_Click" MinWidth="86" />
            <Button x:Name="ConfirmDeleteButton" Content="移入回收站" Style="{StaticResource PrimaryButton}" Click="Confirm_Click" Margin="10,0,0,0" Padding="18,11" />
        </StackPanel>
    </Grid></Border>
</Window>
