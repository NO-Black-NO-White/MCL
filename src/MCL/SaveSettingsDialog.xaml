<Window x:Class="MCL.SaveSettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="保存启动设置" Width="430" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Border Style="{StaticResource Card}" Margin="16" Padding="22,18,22,20"
            Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource HeroBorderBrush}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource DialogShadowColor}" ShadowDepth="3" BlurRadius="22" Opacity="0.25" />
        </Border.Effect>
        <StackPanel>
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Padding="9" Background="{DynamicResource PanelBrush}"
                        Click="Cancel_Click" AutomationProperties.Name="取消退出" ToolTip="取消退出">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Stroke="{DynamicResource MutedBrush}"
                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Button>
                <TextBlock Text="保存启动设置？" FontSize="21" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Text="保存后，下次打开 MCL 会沿用这些设置。"
                       Style="{StaticResource MutedText}" Margin="0,11,0,17" />
            <Border Height="1" Background="{DynamicResource DividerBrush}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="CancelButton" Content="取消" IsCancel="True" Click="Cancel_Click"
                        Background="{DynamicResource PanelBrush}" MinWidth="70" />
                <Button x:Name="DiscardButton" Content="放弃修改" Click="Discard_Click" Margin="8,0,0,0" MinWidth="89" />
                <Button x:Name="SaveButton" Content="保存并退出" Style="{StaticResource PrimaryButton}" Click="Save_Click"
                        Padding="16,11" Margin="8,0,0,0" MinWidth="99" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
