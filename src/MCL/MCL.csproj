<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MCL</AssemblyName>
    <RootNamespace>MCL</RootNamespace>
    <Version>0.9.2</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/mcl.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Multiplayer/RoomProtocol.cs" Link="RoomProtocol.cs" />
    <Resource Include="Assets/spring-valley.jpg" />
    <Resource Include="Assets/autumn-camp.jpg" />
    <Resource Include="Assets/canyon-riders.jpg" />
    <Resource Include="Assets/mcl.ico" />
    <Resource Include="$(MclRelayBundle)" Link="Assets/relay.exe"
              Condition="'$(MclRelayBundle)' != ''" />
    <Resource Include="$(MclCloudflaredBundle)" Link="Assets/cloudflared.exe"
              Condition="'$(MclCloudflaredBundle)' != ''" />
  </ItemGroup>
</Project>
