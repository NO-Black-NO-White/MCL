<Window x:Class="MCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Icon="Assets/mcl.ico" AutomationProperties.Name="MCL"
        Width="1180" Height="820" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Geometry x:Key="HomeIcon">M 2,9 L 10,2 18,9 M 4,8 L 4,17 16,17 16,8 M 8,17 L 8,12 12,12 12,17</Geometry>
        <Geometry x:Key="VersionsIcon">M 3,3 H 8 V 8 H 3 Z M 12,3 H 17 V 8 H 12 Z M 3,12 H 8 V 17 H 3 Z M 12,12 H 17 V 17 H 12 Z</Geometry>
        <Geometry x:Key="DownloadIcon">M 10,2 V 13 M 6,9 L 10,13 14,9 M 3,13 V 17 H 17 V 13</Geometry>
        <Geometry x:Key="PackIcon">M 3,6 L 10,2 17,6 V 14 L 10,18 3,14 Z M 3,6 L 10,10 17,6 M 10,10 V 18 M 6.5,4 L 13.5,8</Geometry>
        <Geometry x:Key="LinkIcon">M 2,7 H 17 M 13,3 L 17,7 13,11 M 18,13 H 3 M 7,9 L 3,13 7,17</Geometry>
        <Geometry x:Key="AccountIcon">M 13.5,6 A 3.5,3.5 0 1 1 6.5,6 A 3.5,3.5 0 1 1 13.5,6 M 3,17 C 3,13 6,11 10,11 C 14,11 17,13 17,17</Geometry>
        <Geometry x:Key="SettingsIcon">M 3,5 H 7 M 11,5 H 17 M 7,2 V 8 M 3,13 H 12 M 16,13 H 17 M 12,10 V 16</Geometry>
        <Geometry x:Key="LogsIcon">M 4,2 H 16 V 18 H 4 Z M 7,6 H 13 M 7,10 H 13 M 7,14 H 11</Geometry>
        <Style x:Key="ShortcutIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{StaticResource AccentTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.55" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style x:Key="NavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,5" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="NavBorder" Background="Transparent" CornerRadius="10" />
                    <Border x:Name="NavMarker" Width="3" VerticalAlignment="Stretch" Margin="0,11,0,11" HorizontalAlignment="Left"
                            CornerRadius="1.5" Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="15,12,9,12">
                        <Path Data="{TemplateBinding CommandParameter}" Style="{StaticResource ShortcutIcon}"
                              Stroke="{TemplateBinding Foreground}" Margin="0,0,12,0" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SoftAccentBrush}" />
                        <Setter TargetName="NavMarker" Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RoomRoleTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="10">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <Border x:Name="SelectionMark" Width="24" Height="3" CornerRadius="1.5" Margin="0,0,0,4"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Background="{StaticResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{StaticResource SoftAccentBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomeVersionSelector" TargetType="ComboBox">
            <Setter Property="IsEnabled" Value="{Binding CanInteract}" />
            <Setter Property="MaxDropDownHeight" Value="304" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,7" Margin="4,2">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{StaticResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource SoftAccentBrush}" />
                                <Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerSurface" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource HeroBorderBrush}"
                                                BorderThickness="1" CornerRadius="12" Padding="13,8">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PickerSurface" Property="Background" Value="{StaticResource HoverBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 5,5 10,0" Stroke="{StaticResource AccentTextBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="13,0,0,0" />
                                    <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="25" FontWeight="Bold"
                                               Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource InputBorderBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="0,3">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False"><Setter Property="IsEnabled" Value="False" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PagePanel" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /></Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="{StaticResource BackgroundBrush}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
        <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="15,24,15,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="9,0,0,27">
                    <Border Width="42" Height="42" CornerRadius="12">
                        <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#D04C83" Offset="0" /><GradientStop Color="#AC295F" Offset="1" />
                        </LinearGradientBrush></Border.Background>
                        <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="24" FontWeight="Black" Foreground="White" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MCL" FontSize="23" FontWeight="Bold" />
                        <TextBlock Text="Java 版启动器" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="HomeNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Home" Checked="Navigation_Checked" Content="首页" CommandParameter="{StaticResource HomeIcon}" />
                    <RadioButton x:Name="VersionsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Versions" Checked="Navigation_Checked" Content="游戏版本" CommandParameter="{StaticResource VersionsIcon}" />
                    <RadioButton x:Name="DownloadsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Downloads" Checked="Navigation_Checked" Content="下载游戏" CommandParameter="{StaticResource DownloadIcon}" />
                    <RadioButton x:Name="ModpacksNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Modpacks" Checked="Navigation_Checked" Content="导入整合包" CommandParameter="{StaticResource PackIcon}" />
                    <RadioButton x:Name="MultiplayerNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Multiplayer" Checked="Navigation_Checked" Content="好友联机" CommandParameter="{StaticResource LinkIcon}" />
                    <RadioButton x:Name="AppearanceNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Appearance" Checked="Navigation_Checked" Content="本地角色" CommandParameter="{StaticResource AccountIcon}" />
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Settings" Checked="Navigation_Checked" Content="启动设置" CommandParameter="{StaticResource SettingsIcon}" />
                    <RadioButton x:Name="LogsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Logs" Checked="Navigation_Checked" Content="运行日志" CommandParameter="{StaticResource LogsIcon}" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="9,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource SoftAccentBrush}">
                                <Path Data="{StaticResource AccountIcon}" Style="{StaticResource ShortcutIcon}" Width="16" Height="16" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" Width="100" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PlayerName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="本地档案" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding AppVersionText}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="9,11,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="30,25,30,16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <TextBlock Text="{Binding PageTitle}" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="11,6">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" />
                        <TextBlock Text="{Binding ActivityText}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" />
                    </StackPanel>
                </Border>
            </Grid>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="PageContent">
                    <Grid.RenderTransform><TranslateTransform x:Name="PageShift" /></Grid.RenderTransform>
                    <Grid x:Name="HomePage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border CornerRadius="21" BorderBrush="{StaticResource HeroBorderBrush}" BorderThickness="1" MinHeight="326">
                            <Border.Background>
                                <ImageBrush ImageSource="/MCL;component/Assets/spring-valley.jpg" Stretch="UniformToFill" AlignmentY="Center" />
                            </Border.Background>
                            <Border CornerRadius="20" Padding="29,25">
                                <Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#FFFFF8FC" Offset="0" />
                                    <GradientStop Color="#FCFFF5F9" Offset="0.28" />
                                    <GradientStop Color="#D8FFF2F7" Offset="0.43" />
                                    <GradientStop Color="#2DFFF1F6" Offset="0.69" />
                                    <GradientStop Color="#00FFF1F6" Offset="1" />
                                </LinearGradientBrush></Border.Background>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="56*" /><ColumnDefinition Width="44*" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="当前游戏" Foreground="{StaticResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                        <ComboBox x:Name="HomeVersionPicker" Style="{StaticResource HomeVersionSelector}"
                                                  ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                  ToolTip="{Binding SelectedVersionTitle}" AutomationProperties.Name="选择已安装的游戏版本" Margin="0,9,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="VersionOptionDetail" Text="{Binding Kind}" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                                                    </StackPanel>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter TargetName="VersionOptionDetail" Property="Text" Value="需要检查" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding SelectedVersionDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,22" />
                                        <WrapPanel>
                                            <Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}" MinWidth="153" Click="Launch_Click" IsEnabled="{Binding CanLaunch}" />
                                            <Button Content="停止游戏" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                                                    Visibility="{Binding IsGameRunning, Converter={StaticResource BoolVisibility}}" />
                                        </WrapPanel>
                                        <Button Content="更改游戏文件夹  →" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="0,4"
                                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}"
                                                Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Border>
                        <UniformGrid Grid.Row="1" Columns="4" Margin="0,17,0,0">
                            <Button Style="{StaticResource ShortcutButton}" Margin="0,0,6,0" Click="ShowVersions_Click" AutomationProperties.Name="游戏版本">
                                <DockPanel LastChildFill="True">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SoftAccentBrush}" Margin="0,0,10,0">
                                        <Path Data="{StaticResource VersionsIcon}" Style="{StaticResource ShortcutIcon}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="游戏版本" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButton}" Margin="6,0" Click="ShowDownloads_Click" AutomationProperties.Name="下载游戏">
                                <DockPanel LastChildFill="True">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SoftAccentBrush}" Margin="0,0,10,0">
                                        <Path Data="{StaticResource DownloadIcon}" Style="{StaticResource ShortcutIcon}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="下载游戏" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButton}" Margin="6,0" Click="ShowModpacks_Click" AutomationProperties.Name="导入整合包">
                                <DockPanel LastChildFill="True">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SoftAccentBrush}" Margin="0,0,10,0">
                                        <Path Data="{StaticResource PackIcon}" Style="{StaticResource ShortcutIcon}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="导入整合包" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                            <Button Style="{StaticResource ShortcutButton}" Margin="6,0,0,0" Click="ShowMultiplayer_Click" AutomationProperties.Name="好友联机">
                                <DockPanel LastChildFill="True">
                                    <Border Width="38" Height="38" CornerRadius="10" Background="{StaticResource SoftAccentBrush}" Margin="0,0,10,0">
                                        <Path Data="{StaticResource LinkIcon}" Style="{StaticResource ShortcutIcon}" />
                                    </Border>
                                    <TextBlock DockPanel.Dock="Right" Text="›" Foreground="{StaticResource MutedBrush}" FontSize="19" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    <TextBlock Text="好友联机" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </Button>
                        </UniformGrid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,17,0,12" Padding="19,15">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.15*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Java" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding JavaSummary}" FontWeight="SemiBold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="分配内存" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding MemorySummary}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="本地版本" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                    <TextBlock Text="{Binding VersionCountLabel}" FontWeight="SemiBold" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="启动设置  →" Click="ShowSettings_Click" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>
                    <Grid x:Name="VersionsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="18,12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                    <TextBlock Text="游戏文件夹" FontWeight="SemiBold" FontSize="13" />
                                    <TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="选择文件夹" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                                <Button Grid.Column="2" Content="刷新" Click="RefreshVersions_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </Border>
                        <Grid x:Name="VersionsWorkspace" Grid.Row="1" Margin="0,16,0,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="34*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="66*" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="12,15,12,5">
                                <StackPanel>
                                    <Grid Margin="5,0,5,12">
                                        <TextBlock Text="已安装版本" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding VersionCountLabel}" FontSize="11" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <ListBox x:Name="VersionList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                             IsEnabled="{Binding CanInteract}" MinHeight="320" MaxHeight="385" AutomationProperties.Name="已安装版本"
                                             VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                             PreviewMouseWheel="VersionList_PreviewMouseWheel" PreviewMouseDown="VersionList_CancelWheelAnimation"
                                             PreviewKeyDown="VersionList_CancelWheelAnimation">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ToolTip="{Binding DisplayName}">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Path x:Name="VersionRowIcon" Style="{StaticResource ShortcutIcon}" Data="{StaticResource PackIcon}" HorizontalAlignment="Left" />
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock x:Name="VersionRowKind" Text="{Binding Kind}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Grid>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding ModpackName}" Value="{x:Null}">
                                                        <Setter TargetName="VersionRowIcon" Property="Path.Data" Value="{StaticResource VersionsIcon}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                        <Setter TargetName="VersionRowKind" Property="TextBlock.Foreground" Value="{StaticResource AccentTextBrush}" />
                                                        <Setter TargetName="VersionRowKind" Property="TextBlock.Text" Value="需要检查" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                            <Border x:Name="VersionManagementCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel>
                                        <Border BorderBrush="{StaticResource HeroBorderBrush}" BorderThickness="1" CornerRadius="12">
                                            <Border.Background>
                                                <ImageBrush x:Name="VersionArtwork" ImageSource="{Binding ManagedVersionArtwork}"
                                                            Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
                                            </Border.Background>
                                            <Border CornerRadius="11" MinHeight="146" Padding="18,15">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                        <GradientStop Color="#FFFFF7FA" Offset="0" /><GradientStop Color="#F9FFF4F9" Offset="0.43" />
                                                        <GradientStop Color="#CFFFF3F8" Offset="0.62" /><GradientStop Color="#00FFF1F6" Offset="1" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="68*" /><ColumnDefinition Width="32*" /></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedVersion.Kind}" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" FontSize="12" />
                                                        <TextBlock Text="{Binding ManagedVersionTitle}" ToolTip="{Binding ManagedVersionTitle}" FontSize="28" FontWeight="Bold"
                                                                   TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="78" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Border>
                                        <UniformGrid Rows="1" Margin="4,14,4,8">
                                            <StackPanel Margin="0,0,8,0">
                                                <TextBlock Text="Minecraft 版本" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding ManagedMinecraftVersion}" ToolTip="{Binding ManagedMinecraftVersion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="加载器" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding ManagedVersionLoader}" ToolTip="{Binding ManagedVersionLoader}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="8,0,0,0" Visibility="{Binding ManagedVersionHasPackVersion, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="整合包版本" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                                <TextBlock Text="{Binding SelectedVersion.ModpackVersion}" ToolTip="{Binding SelectedVersion.ModpackVersion}"
                                                           FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding SelectedVersion.Issue}" Style="{StaticResource MutedText}" Foreground="{StaticResource AccentTextBrush}"
                                                   Visibility="{Binding ManagedVersionNeedsAttention, Converter={StaticResource BoolVisibility}}" Margin="4,0,4,8" />
                                    </StackPanel>
                                    <Button x:Name="LaunchSelectedVersionButton" Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Left" Margin="4,5,4,15" MinWidth="126" Click="Launch_Click" IsEnabled="{Binding CanLaunch}" />
                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="4,12,4,0">
                                        <StackPanel>
                                            <TextBlock Text="版本管理" FontSize="13" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ManagedVersionPath}" ToolTip="{Binding ManagedVersionPath}" Foreground="{StaticResource MutedBrush}"
                                                       FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,5,0,9" />
                                            <WrapPanel>
                                                <Button Content="打开文件夹" Click="OpenVersionFolder_Click" IsEnabled="{Binding CanOpenVersionFolder}" Margin="0,0,8,0" />
                                                <Button x:Name="DeleteVersionButton" Content="删除版本" Foreground="#A22A4C" Background="#FFF1F5" BorderBrush="#E7B5C8"
                                                        Click="DeleteSelectedVersion_Click" IsEnabled="{Binding CanDeleteVersion}" />
                                            </WrapPanel>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="备份存档" Click="BackupSaves_Click" IsEnabled="{Binding CanManageSaves}" Margin="0,0,8,5" />
                                                <Button Content="恢复存档" Click="RestoreSaves_Click" IsEnabled="{Binding CanManageSaves}" Margin="0,0,8,5" />
                                                <Button Content="导出整合包" Click="ExportModpack_Click" IsEnabled="{Binding CanShareModpack}"
                                                        Visibility="{Binding ManagedVersionIsModpack, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,5"
                                                        ToolTip="分享包包含模组、配置和资源包。请在发送前检查打包内容。" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding VersionManagementHint}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Border x:Name="EmptyVersions" Grid.Row="1" Style="{StaticResource Card}" MinHeight="290" Margin="0,16,0,0">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="{StaticResource VersionsIcon}" Style="{StaticResource ShortcutIcon}" Width="26" Height="26" />
                                <TextBlock Text="还没有发现游戏版本" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5" />
                                <TextBlock Text="下载一个原版版本，或导入你已有的整合包。" Style="{StaticResource MutedText}" TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                    <Button Content="下载游戏" Style="{StaticResource PrimaryButton}" Click="ShowDownloads_Click" />
                                    <Button Content="导入整合包" Click="ShowModpacks_Click" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="DownloadsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="游戏安装位置" FontWeight="SemiBold" /><TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,6,16,0" /></StackPanel>
                            <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                        </Grid></Border>
                        <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14"><TextBlock Text="原版游戏版本" FontSize="15" FontWeight="SemiBold" /><Button Content="刷新列表" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" Click="RefreshRemote_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                    <Grid><TextBox Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="搜索下载版本" IsEnabled="{Binding CanInteract}" /><TextBlock Text="搜索版本号，例如 1.8.9" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VersionSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                    <WrapPanel Margin="0,10,0,0">
                                        <CheckBox Content="显示快照和预发布版" IsChecked="{Binding ShowSnapshots}" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RemoteCountText}" Style="{StaticResource MutedText}" FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                                <Grid Grid.Row="2" MinHeight="190"><ListBox x:Name="RemoteVersionList" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedRemoteVersion, Mode=TwoWay}" SelectionChanged="RemoteVersion_SelectionChanged" IsEnabled="{Binding CanInteract}" MaxHeight="290"
                                                                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
                                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Id}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding KindText}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox><Border x:Name="EmptyRemote" Background="{StaticResource PanelBrush}" Padding="12"><StackPanel VerticalAlignment="Center"><TextBlock Text="等待版本列表" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="点击刷新，从官方获取可安装的版本。&#10;搜索无结果时，可以换一个版本号。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0" /></StackPanel></Border></Grid>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel>
                                <TextBlock Text="即将安装" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteVersionTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="运行要求" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteJava}" Foreground="{StaticResource AccentTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="参考内容大小" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteSize}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,12" />
                                <TextBlock Text="游戏本体、依赖和资源将一起安装，完整的已有文件会复用。" Style="{StaticResource MutedText}" FontSize="11" LineHeight="20" Margin="0,0,0,14" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}" Padding="14,12" Click="InstallVersion_Click" IsEnabled="{Binding CanInstall}" /><Button Grid.Column="1" Content="取消" Click="CancelInstall_Click" IsEnabled="{Binding CanCancelInstall}" Padding="13,12" Margin="8,0,0,0" /></Grid>
                            </StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><StackPanel><Grid><TextBlock Text="{Binding InstallStage}" FontWeight="SemiBold" /><TextBlock Text="{Binding InstallSpeed}" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" FontSize="12" /></Grid>
                            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding InstallPercent, Mode=OneWay}" IsIndeterminate="{Binding InstallIndeterminate, Mode=OneWay}" Margin="0,10,0,8" />
                            <TextBlock Text="{Binding InstallDetail}" Style="{StaticResource MutedText}" FontSize="12" /><Grid Margin="0,8,0,0"><TextBlock Text="{Binding InstallFiles}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding InstallTransfer}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                            <Button x:Name="InstalledShortcut" Content="查看已安装版本  →" Visibility="Collapsed" Click="ShowVersions_Click" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" />
                        </StackPanel></Border>
                    </Grid>
                    <Grid x:Name="ModpacksPage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="24"
                                    AllowDrop="True" DragOver="Pack_DragOver" Drop="Pack_Drop">
                                <StackPanel>
                                    <TextBlock Text="选择或拖入整合包" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="支持 Modrinth .mrpack（原版、Fabric）和 CurseForge ZIP（原版、Fabric、Forge 1.20.1）。"
                                               Style="{StaticResource MutedText}" Margin="0,10,0,17" />
                                    <Button Content="选择整合包文件…" Click="ChoosePack_Click" IsEnabled="{Binding CanChoosePack}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="安装位置" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GameDirectory}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanChoosePack}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0"
                                    Visibility="{Binding HasPack, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PackName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PackDetails}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding PackFileSummary}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding PackFileName}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                                    <CheckBox Content="{Binding PackOptionalText}" IsChecked="{Binding IncludeOptionalPackFiles}"
                                              IsEnabled="{Binding CanImportPack}" Visibility="{Binding HasOptionalPackFiles, Converter={StaticResource BoolVisibility}}"
                                              Margin="0,12,0,0" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="安装整合包" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanImportPack}" Click="InstallPack_Click" />
                                        <Button Content="选择补充文件夹" Click="ChoosePackLocalFiles_Click" IsEnabled="{Binding CanImportPack}"
                                                Visibility="{Binding IsCurseForgePack, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                        <Button Content="取消安装" IsEnabled="{Binding CanCancelPack}" Click="CancelPack_Click"
                                                Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                        <Button Content="返回首页启动" Click="ShowPackHome_Click"
                                                Visibility="{Binding PackCompleted, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PackStatus}" TextWrapping="Wrap" />
                                    <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding PackPercent, Mode=OneWay}" IsIndeterminate="{Binding PackIndeterminate, Mode=OneWay}"
                                                 Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="MultiplayerPage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="5" Margin="0,0,0,14">
                                <Grid IsEnabled="{Binding CanEditRelay}" KeyboardNavigation.DirectionalNavigation="Cycle">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="HostRoleButton" Content="创建房间" Style="{StaticResource RoomRoleTab}" GroupName="MultiplayerRole"
                                                 IsChecked="{Binding ShowHostSetup, Mode=TwoWay}" />
                                    <RadioButton x:Name="GuestRoleButton" Grid.Column="2" Content="加入房间" Style="{StaticResource RoomRoleTab}" GroupName="MultiplayerRole"
                                                 IsChecked="{Binding ShowGuestSetup, Mode=TwoWay}" />
                                </Grid>
                            </Border>
                            <Border x:Name="HostRoomCard" Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="24"
                                    Visibility="{Binding ShowHostSetup, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="邀请好友进入你的存档" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="选好版本和存档，再在游戏里点「对局域网开放」。MCL 会自动准备本机中转和临时公网隧道。"
                                               Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding LanRoomStatus}" TextWrapping="Wrap" Margin="0,10,0,14" />
                                    <WrapPanel>
                                        <Button Content="{Binding HostRoomButtonText}" Style="{StaticResource PrimaryButton}" Click="HostRoom_Click" IsEnabled="{Binding CanHostRoom}" />
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding HasRoomCode, Converter={StaticResource BoolVisibility}}" Margin="0,13,0,0">
                                        <TextBlock Text="邀请码" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <DockPanel>
                                            <Button Content="复制邀请码" DockPanel.Dock="Right" Click="CopyRoom_Click" Margin="9,0,0,0" />
                                            <TextBox Text="{Binding RoomCode, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="GuestRoomCard" Style="{StaticResource Card}" Padding="20"
                                    Visibility="{Binding ShowGuestSetup, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="加入好友房间" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="使用与房主相同的 Java 版游戏版本和模组。支持 1.20 及以上。" Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                                    <DockPanel>
                                        <Button x:Name="JoinRoomButton" Content="{Binding JoinRoomButtonText}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="JoinRoom_Click" IsEnabled="{Binding CanJoinRoom}" Margin="9,0,0,0" />
                                        <Grid>
                                            <TextBox Text="{Binding InviteInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" IsEnabled="{Binding CanEditRelay}" VerticalContentAlignment="Center" AutomationProperties.Name="好友邀请码" />
                                            <TextBlock Text="粘贴好友邀请码" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0"
                                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding InviteInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </DockPanel>
                                    <Button Content="对比好友分享包" Click="CompareModpack_Click" IsEnabled="{Binding CanCompareModpack}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding MultiplayerStage}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding MultiplayerStatus}" TextWrapping="Wrap" />
                                    <Button Content="结束联机" Click="CloseRoom_Click" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding MultiplayerActive, Converter={StaticResource BoolVisibility}}" />
                                    <Expander Header="手动中转设置" Margin="0,10,0,0" IsEnabled="{Binding CanEditRelay}">
                                        <StackPanel>
                                            <TextBlock Text="已有共享中转或收到旧版邀请码时，可填写地址。" Style="{StaticResource MutedText}" Margin="0,5,0,6" />
                                            <TextBox Text="{Binding RelayEndpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRelay}" AutomationProperties.Name="联机服务地址" />
                                            <CheckBox Content="创建房间时使用这个中转地址" IsChecked="{Binding UseSharedRelay}" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AppearancePage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="22">
                                <StackPanel IsEnabled="{Binding CanEditLocalAppearance}">
                                    <TextBlock Text="游戏内 ID（玩家名）" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <TextBox x:Name="LocalPlayerNameBox" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                                             AutomationProperties.Name="游戏内玩家名" />
                                    <TextBlock Text="1–16 位英文字母、数字或下划线。改名后，部分存档里的背包或进度会按新玩家记录。"
                                               Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,13" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Card}" Padding="12" VerticalAlignment="Top">
                                            <StackPanel>
                                                <Border x:Name="CharacterStage" CornerRadius="10" Cursor="Hand"
                                                        MouseLeftButtonDown="CharacterPreview_MouseDown" MouseMove="CharacterPreview_MouseMove"
                                                        MouseLeftButtonUp="CharacterPreview_MouseUp" AutomationProperties.Name="角色 3D 预览">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFFF5F9" Offset="0" />
                                                            <GradientStop Color="#FFF2E0F0" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Viewport3D Width="218" Height="204" IsHitTestVisible="False" ClipToBounds="False">
                                                        <Viewport3D.Camera>
                                                            <OrthographicCamera Position="0,0,96" LookDirection="0,0,-1" UpDirection="0,1,0" Width="39" />
                                                        </Viewport3D.Camera>
                                                        <ModelVisual3D>
                                                            <ModelVisual3D.Content>
                                                                <Model3DGroup>
                                                                    <AmbientLight Color="#FFABABAB" />
                                                                    <DirectionalLight Color="#FF656565" Direction="-1,-2,-3" />
                                                                    <DirectionalLight Color="#FF303030" Direction="1,-1,2" />
                                                                </Model3DGroup>
                                                            </ModelVisual3D.Content>
                                                        </ModelVisual3D>
                                                        <ModelVisual3D x:Name="CharacterVisual">
                                                            <ModelVisual3D.Transform>
                                                                <Transform3DGroup>
                                                                    <RotateTransform3D>
                                                                        <RotateTransform3D.Rotation>
                                                                            <AxisAngleRotation3D x:Name="CharacterYaw" Axis="0,1,0" Angle="18" />
                                                                        </RotateTransform3D.Rotation>
                                                                    </RotateTransform3D>
                                                                    <RotateTransform3D>
                                                                        <RotateTransform3D.Rotation>
                                                                            <AxisAngleRotation3D x:Name="CharacterPitch" Axis="1,0,0" Angle="8" />
                                                                        </RotateTransform3D.Rotation>
                                                                    </RotateTransform3D>
                                                                </Transform3DGroup>
                                                            </ModelVisual3D.Transform>
                                                        </ModelVisual3D>
                                                    </Viewport3D>
                                                </Border>
                                                <WrapPanel HorizontalAlignment="Center" Margin="0,8,0,0">
                                                    <Button Content="正面" Click="ShowCharacterFront_Click" Padding="10,5" Margin="0,0,6,0"
                                                            AutomationProperties.Name="查看角色正面" />
                                                    <Button Content="背面" Click="ShowCharacterBack_Click" Padding="10,5"
                                                            AutomationProperties.Name="查看角色背面" />
                                                </WrapPanel>
                                                <TextBlock Text="拖动角色旋转" Style="{StaticResource MutedText}" FontSize="11"
                                                           HorizontalAlignment="Center" Margin="0,6,0,0" />
                                                <TextBlock Text="{Binding PublicAppearanceName, StringFormat=正在预览 · {0}}"
                                                           Visibility="{Binding IsPreviewingPublicAppearance, Converter={StaticResource BoolVisibility}}"
                                                           Foreground="{StaticResource AccentTextBrush}" FontSize="11"
                                                           HorizontalAlignment="Center" Margin="0,5,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Grid.Column="2">
                                            <Border Style="{StaticResource Card}" Padding="13">
                                                <StackPanel>
                                                    <TextBlock Text="皮肤" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding LocalSkinLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" />
                                                    <WrapPanel>
                                                        <Button Content="选择 PNG" Click="PickLocalSkin_Click" Padding="11,6" Margin="0,0,6,0" />
                                                        <Button Content="清除" Click="ClearLocalSkin_Click" Padding="9,6" IsEnabled="{Binding HasLocalSkin}" />
                                                    </WrapPanel>
                                                    <CheckBox IsChecked="{Binding UseSlimSkin}" IsEnabled="{Binding HasLocalSkin}" Margin="0,8,0,0">
                                                        <TextBlock Text="使用细手臂模型（Alex）" TextWrapping="Wrap" />
                                                    </CheckBox>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Padding="13" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="披风" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding LocalCapeLabel}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,0,0,5" />
                                                    <WrapPanel>
                                                        <Button Content="选择 PNG" Click="PickLocalCape_Click" Padding="11,6" Margin="0,0,6,0" />
                                                        <Button Content="清除" Click="ClearLocalCape_Click" Padding="9,6" IsEnabled="{Binding HasLocalCape}" />
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource Card}" Padding="13" Margin="0,10,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="按 Java 玩家名导入" FontWeight="SemiBold" />
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBox Text="{Binding PublicPlayerName, UpdateSourceTrigger=PropertyChanged}"
                                                                 MaxLength="16" KeyDown="PublicPlayerNameBox_KeyDown"
                                                                 AutomationProperties.Name="要查询的 Java 玩家名" />
                                                        <Button Grid.Column="1" Content="查询" Click="LookupPublicAppearance_Click" Margin="8,0,0,0" />
                                                    </Grid>
                                                    <TextBlock Text="{Binding PublicAppearanceStatus}" Style="{StaticResource MutedText}" FontSize="11"
                                                               TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    <StackPanel Visibility="{Binding HasPublicAppearance, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
                                                        <TextBlock Text="{Binding PublicAppearanceName}" FontWeight="SemiBold" />
                                                        <TextBox Text="{Binding PublicAppearanceUuid, Mode=OneWay}" IsReadOnly="True"
                                                                 FontSize="11" Margin="0,5,0,0" AutomationProperties.Name="公开角色 UUID" />
                                                        <WrapPanel Margin="0,7,0,0">
                                                            <Button Content="导入外观" Click="ImportPublicAppearance_Click" IsEnabled="{Binding HasPublicTextures}"
                                                                    Padding="9,5" Margin="0,0,6,5" />
                                                            <Button Content="使用玩家名" Click="UsePublicPlayerName_Click" Padding="9,5" Margin="0,0,6,5" />
                                                            <Button Content="{Binding PublicPreviewButtonLabel}" Click="TogglePublicAppearancePreview_Click"
                                                                    IsEnabled="{Binding HasPublicTextures}" Padding="9,5" Margin="0,0,0,5" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox Content="启动时应用外观" IsChecked="{Binding ApplyLocalAppearance}" Margin="0,13,0,0" />
                                    <TextBlock Text="首次使用需要联网安装外观组件。自定义皮肤和披风仅在本机显示。" Style="{StaticResource MutedText}"
                                               FontSize="11" Margin="0,4,0,7" />
                                    <WrapPanel>
                                        <Button Content="保存本地角色" Style="{StaticResource PrimaryButton}" Click="SaveLocalAppearance_Click" />
                                        <TextBlock Text="{Binding LocalAppearanceStatus}" TextWrapping="Wrap" MaxWidth="440"
                                                   VerticalAlignment="Center" Margin="10,3,0,3" FontSize="11" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0">
                                <StackPanel>
                                    <TextBlock Text="从正版账号导入" FontSize="17" FontWeight="SemiBold" />
                                    <TextBlock Text="登录微软账号，获取 Minecraft Java 版角色资料。游戏使用已保存的本地角色启动。"
                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,5,0,12" />
                                    <WrapPanel>
                                        <Button x:Name="ProfileSignInButton" Content="登录微软账号" Click="SignInForProfile_Click"
                                                IsEnabled="{Binding CanSignInForProfile}" Margin="0,0,8,7" />
                                        <Button x:Name="ProfileRefreshButton" Content="刷新资料" Click="RefreshOnlineProfile_Click"
                                                IsEnabled="{Binding CanRefreshOnlineProfile}"
                                                Visibility="{Binding HasOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,7" />
                                        <Button x:Name="ProfileClearButton" Content="清除登录" Click="ClearOnlineProfile_Click"
                                                Visibility="{Binding CanClearOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,7" />
                                        <Button Content="取消" Click="CancelProfileOperation_Click"
                                                Visibility="{Binding CanCancelProfileOperation, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7" />
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding HasOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,7,0,5">
                                        <TextBlock Text="{Binding OnlineProfileName}" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="角色 UUID" Style="{StaticResource MutedText}" Margin="0,6,0,5" />
                                        <TextBox Text="{Binding OnlineProfileId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="角色 UUID" />
                                        <TextBlock Text="{Binding OnlineAppearanceSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,8" />
                                        <WrapPanel>
                                            <Button x:Name="ProfileNameButton" Content="使用这个昵称" Click="UseOnlineName_Click"
                                                    IsEnabled="{Binding CanUseOnlineName}" Margin="0,0,8,7" />
                                            <Button x:Name="ProfileSkinButton" Content="导入当前皮肤" Click="ImportOnlineSkin_Click"
                                                    IsEnabled="{Binding CanImportOnlineSkin}" Margin="0,0,8,7" />
                                            <Button x:Name="ProfileCapeButton" Content="导入当前披风" Click="ImportOnlineCape_Click"
                                                    IsEnabled="{Binding CanImportOnlineCape}" Margin="0,0,0,7" />
                                        </WrapPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding OnlineProfileStatus}" Style="{StaticResource MutedText}"
                                               TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Expander Header="启动器应用 ID" IsEnabled="{Binding CanEditLocalAppearance}">
                                        <StackPanel Margin="0,10,0,0">
                                            <TextBlock Text="填写已取得 Minecraft 接口访问许可的应用（客户端）ID。"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                            <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                                                     AutomationProperties.Name="启动器应用 ID" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SettingsPage" Style="{StaticResource PagePanel}" IsEnabled="{Binding CanInteract}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="游戏与档案" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
                                <TextBlock Text="游戏文件夹" FontSize="12" Margin="0,0,0,8" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择包含 versions、libraries 和 assets 的游戏目录" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <TextBlock Text="本地玩家名称" FontSize="12" Margin="0,21,0,8" /><TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                                <TextBlock Text="使用 1–16 位英文字母、数字或下划线。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
                                <TextBlock Text="运行环境" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
                                <Grid><CheckBox Content="根据游戏版本自动匹配 Java" IsChecked="{Binding AutoMatchJava}" /><Button Content="重新检测" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Right" Click="DetectJava_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <TextBlock Text="自定义 Java 路径（可选）" FontSize="12" Margin="0,12,0,0" />
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseJava_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <TextBlock Text="{Binding JavaDetail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                                <Grid Margin="0,23,0,8"><TextBlock Text="最大游戏内存" FontSize="12" /><TextBlock Text="{Binding MemorySummary}" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" FontSize="13" /></Grid>
                                <Slider Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock Text="建议先使用 4096 MB，并为 Windows 和其他程序保留足够内存。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel></Border>
                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource MutedText}" Margin="0,16,0,15" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LogsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15"><TextBlock Text="启动器与游戏的运行记录" Style="{StaticResource MutedText}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制日志" Click="CopyLogs_Click" /><Button Content="打开日志文件夹" Margin="9,0,0,0" Click="OpenLogs_Click" /></StackPanel></Grid>
                        <Border Grid.Row="1" Background="{StaticResource LogBackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" MinHeight="430">
                            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" MaxHeight="550" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,4" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LogTextBrush}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,11,0,0" Margin="0,10,0,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,15,0" VerticalAlignment="Center" />
                    <Button x:Name="FooterSaveButton" Grid.Column="1" Content="保存设置" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"
                            Padding="18,9" Click="SaveSettings_Click" IsEnabled="{Binding CanInteract}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
