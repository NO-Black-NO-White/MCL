<Window x:Class="MCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCL · 我的 Minecraft 启动器" Width="1180" Height="820" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Style x:Key="NavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" /><Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,7" /><Setter Property="Padding" Value="17,14" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border x:Name="NavBorder" Background="Transparent" CornerRadius="9" Padding="{TemplateBinding Padding}">
                    <ContentPresenter />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource SoftAccentBrush}" /><Setter Property="Foreground" Value="{StaticResource AccentTextBrush}" /></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBorder" Property="Background" Value="{StaticResource HoverBrush}" /></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PagePanel" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /></Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="{StaticResource BackgroundBrush}" TextOptions.TextFormattingMode="Display">
        <Grid.ColumnDefinitions><ColumnDefinition Width="196" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="18,29,18,20">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="52" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentBrush}"><TextBlock Text="M" FontSize="24" FontWeight="Black" Foreground="{StaticResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                    <StackPanel Margin="11,-2,0,0"><TextBlock Text="MCL" FontSize="23" FontWeight="Bold" /><TextBlock Text="你的世界，由此开始" FontSize="9" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0" /></StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="2">
                    <TextBlock Text="工作空间" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="17,0,0,12" />
                    <RadioButton x:Name="HomeNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Home" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⌂" FontSize="20" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="首页" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="VersionsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Versions" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="▦" FontSize="18" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="游戏版本" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="DownloadsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Downloads" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="↓" FontSize="20" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="下载游戏" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="ModpacksNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Modpacks" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="◇" FontSize="20" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="导入整合包" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="MultiplayerNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Multiplayer" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⇄" FontSize="20" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="好友联机" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="AccountsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Accounts" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="♙" FontSize="20" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="账号管理" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Settings" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="⚙" FontSize="18" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="启动设置" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                    <RadioButton x:Name="LogsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Logs" Checked="Navigation_Checked"><StackPanel Orientation="Horizontal"><TextBlock Text="≡" FontSize="21" Width="31" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /><TextBlock Text="运行日志" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" /></StackPanel></RadioButton>
                </StackPanel>
                <StackPanel Grid.Row="4">
                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="8,0,8,19" />
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0"><Border Width="33" Height="33" CornerRadius="8" Background="{StaticResource SoftAccentBrush}"><TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}" /></Border><StackPanel Margin="10,0,0,0" Width="106"><TextBlock Text="{Binding ActivePlayerName}" FontSize="12" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding ActiveAccountLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" /></StackPanel></StackPanel>
                    <TextBlock Text="MCL  /  0.6.0" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="8,24,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="32,27,32,18">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Grid Margin="0,0,0,25">
                <StackPanel><TextBlock Text="MINECRAFT JAVA EDITION" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="SemiBold" /><TextBlock Text="{Binding PageTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{StaticResource SoftAccentBrush}" CornerRadius="16" Padding="12,7"><StackPanel Orientation="Horizontal"><Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" Margin="0,0,7,0" /><TextBlock Text="{Binding ActivityText}" Foreground="{StaticResource AccentTextBrush}" FontSize="11" /></StackPanel></Border>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid x:Name="HomePage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border CornerRadius="16" Background="{StaticResource HeroBrush}" BorderBrush="{StaticResource HeroBorderBrush}" BorderThickness="1" Padding="28,26" MinHeight="232">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="236" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="LET'S PLAY." Foreground="{StaticResource AccentTextBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,0,14" />
                                    <TextBlock Text="从这里，进入你的世界。" FontSize="29" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="熟悉的方块，全新的冒险。&#10;下载一个新版本，或把已有的游戏加入 MCL。" Style="{StaticResource MutedText}" Margin="0,13,0,20" />
                                    <StackPanel Orientation="Horizontal"><Button Content="↓  下载新版本" Style="{StaticResource PrimaryButton}" Click="ShowDownloads_Click" /><Button Content="选择已有游戏" Margin="10,0,0,0" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /></StackPanel>
                                </StackPanel>
                                <Viewbox Grid.Column="1" Width="220" Height="188" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <Canvas Width="240" Height="205">
                                        <Ellipse Width="188" Height="33" Fill="#EED9E4" Canvas.Left="27" Canvas.Top="163" />
                                        <Path Data="M 42,103 L 117,64 194,103 118,144 Z" Fill="#F2BCD3" />
                                        <Path Data="M 42,103 L 118,144 118,187 42,147 Z" Fill="#CF87A8" />
                                        <Path Data="M 118,144 L 194,103 194,147 118,187 Z" Fill="#B96991" />
                                        <Path Data="M 42,103 L 118,144 118,156 42,115 Z" Fill="#EFAAC8" />
                                        <Path Data="M 118,144 L 194,103 194,115 118,156 Z" Fill="#D991B3" />
                                        <Path Data="M 106,113 L 118,119 118,145 106,139 Z" Fill="#B88E9F" />
                                        <Path Data="M 118,119 L 129,113 129,139 118,145 Z" Fill="#976C83" />
                                        <Path Data="M 69,63 L 117,38 167,63 118,89 Z" Fill="#FFD2E5" />
                                        <Path Data="M 69,63 L 118,89 118,126 69,100 Z" Fill="#E69DBD" />
                                        <Path Data="M 118,89 L 167,63 167,100 118,126 Z" Fill="#C779A1" />
                                        <Path Data="M 83,39 L 118,20 153,39 118,58 Z" Fill="#FFE1ED" />
                                        <Path Data="M 83,39 L 118,58 118,82 83,63 Z" Fill="#F1B6D0" />
                                        <Path Data="M 118,58 L 153,39 153,63 118,82 Z" Fill="#DB95B7" />
                                        <Rectangle Width="9" Height="9" Fill="#D99DB9" Canvas.Left="27" Canvas.Top="57" />
                                        <Rectangle Width="5" Height="5" Fill="#E3A8C3" Canvas.Left="193" Canvas.Top="40" />
                                        <Rectangle Width="7" Height="7" Fill="#C888A6" Canvas.Left="209" Canvas.Top="118" />
                                    </Canvas>
                                </Viewbox>
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="0,20,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="290" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid><TextBlock Text="准备启动" FontWeight="SemiBold" /><Button Content="管理版本  →" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Click="ShowVersions_Click" /></Grid>
                                    <TextBlock Text="{Binding SelectedVersionTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,21,0,6" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding SelectedVersionDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,17" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanLaunch}" Click="Launch_Click" /><Button Grid.Column="1" Content="停止" Margin="9,0,0,0" IsEnabled="{Binding CanStop}" Click="Stop_Click" /></Grid>
                                    <Button Content="{Binding LaunchAccountHint}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0" HorizontalAlignment="Left" Click="ShowAccounts_Click" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="运行环境" FontWeight="SemiBold" Margin="0,0,0,20" />
                                    <Grid><TextBlock Text="Java" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding JavaSummary}" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" FontSize="13" /></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12" />
                                    <Grid><TextBlock Text="分配内存" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding MemorySummary}" HorizontalAlignment="Right" FontSize="13" /></Grid>
                                    <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,12,0,12" />
                                    <Grid><TextBlock Text="本地版本" Style="{StaticResource MutedText}" /><TextBlock Text="{Binding VersionCountLabel}" HorizontalAlignment="Right" FontSize="13" /></Grid>
                                    <Button Content="调整启动设置  →" Margin="0,19,0,0" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Foreground="{StaticResource MutedBrush}" Click="ShowSettings_Click" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Grid.Row="2" Text="官方版本，按需下载。已有且完整的游戏资源会自动复用。" Style="{StaticResource MutedText}" FontSize="11" Margin="2,17,0,10" />
                    </Grid>
                    <Grid x:Name="VersionsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="游戏文件夹" FontWeight="SemiBold" /><TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" TextTrimming="CharacterEllipsis" Style="{StaticResource MutedText}" Margin="0,7,16,0" /></StackPanel>
                                <Button Grid.Column="1" Content="选择文件夹" VerticalAlignment="Center" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /><Button Grid.Column="2" Content="刷新" VerticalAlignment="Center" Margin="9,0,0,0" Click="RefreshVersions_Click" IsEnabled="{Binding CanInteract}" />
                            </Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="2,20,2,14"><TextBlock Text="已安装的版本" FontWeight="SemiBold" /><TextBlock Text="选中后可启动或管理版本" Style="{StaticResource MutedText}" HorizontalAlignment="Right" FontSize="11" /></Grid>
                        <Grid Grid.Row="2">
                            <ListBox x:Name="VersionList" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}" IsEnabled="{Binding CanInteract}" MinHeight="180" MaxHeight="245" SelectionChanged="VersionList_SelectionChanged">
                                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" Background="{StaticResource SoftAccentBrush}" CornerRadius="7" HorizontalAlignment="Left"><TextBlock Text="▦" FontSize="22" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,4,0,0" /></StackPanel>
                                    <StackPanel Grid.Column="2" Margin="16,0,0,0"><TextBlock Text="{Binding Kind}" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Right" FontSize="12" /><TextBlock Text="{Binding StatusText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right" /></StackPanel>
                                </Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="EmptyVersions" Style="{StaticResource Card}" MinHeight="270"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="＋" Foreground="{StaticResource AccentTextBrush}" FontSize="38" HorizontalAlignment="Center" /><TextBlock Text="还没有发现游戏版本" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,10" /><TextBlock Text="下载一个新的原版版本，或选择已有游戏的文件夹。" Style="{StaticResource MutedText}" TextAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0"><Button Content="下载游戏" Style="{StaticResource PrimaryButton}" Click="ShowDownloads_Click" /><Button Content="选择文件夹" Margin="10,0,0,0" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /></StackPanel></StackPanel></Border>
                        </Grid>
                        <Border x:Name="VersionManagementCard" Grid.Row="3" Style="{StaticResource Card}" Padding="20" Margin="0,16,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="版本管理" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding ManagedVersionTitle}" FontSize="20" FontWeight="SemiBold" Margin="0,5,16,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="打开文件夹" Click="OpenVersionFolder_Click" IsEnabled="{Binding CanOpenVersionFolder}" /><Button x:Name="DeleteVersionButton" Content="删除版本" Foreground="#A22A4C" Background="#FFF1F5" BorderBrush="#E7B5C8" Click="DeleteSelectedVersion_Click" IsEnabled="{Binding CanDeleteVersion}" Margin="10,0,0,0" /></StackPanel>
                                </Grid>
                                <TextBlock Text="{Binding ManagedVersionPath}" ToolTip="{Binding ManagedVersionPath}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,12,0,5" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding VersionManagementHint}" Style="{StaticResource MutedText}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Grid x:Name="DownloadsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="游戏安装位置" FontWeight="SemiBold" /><TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,6,16,0" /></StackPanel>
                            <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                        </Grid></Border>
                        <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="20" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid Margin="0,0,0,14"><TextBlock Text="原版正式版 · 1.13+" FontSize="15" FontWeight="SemiBold" /><Button Content="刷新列表" HorizontalAlignment="Right" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" Click="RefreshRemote_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}" ToolTip="输入版本号搜索，例如 1.20.1" IsEnabled="{Binding CanInteract}" /><TextBlock Text="搜索版本号，例如 1.20.1" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="12,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VersionSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
                                <Grid Grid.Row="2" MinHeight="190"><ListBox x:Name="RemoteVersionList" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedRemoteVersion, Mode=TwoWay}" SelectionChanged="RemoteVersion_SelectionChanged" IsEnabled="{Binding CanInteract}" MaxHeight="200">
                                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Id}" FontSize="16" FontWeight="SemiBold" /><TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="正式版" Foreground="{StaticResource AccentTextBrush}" FontSize="11" VerticalAlignment="Center" Margin="10,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox><Border x:Name="EmptyRemote" Background="{StaticResource PanelBrush}" Padding="12"><StackPanel VerticalAlignment="Center"><TextBlock Text="等待版本列表" HorizontalAlignment="Center" FontSize="17" FontWeight="SemiBold" /><TextBlock Text="点击刷新，从官方获取可安装的版本。&#10;搜索无结果时，可以换一个版本号。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,10,0,0" /></StackPanel></Border></Grid>
                            </Grid></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel>
                                <TextBlock Text="即将安装" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteVersionTitle}" FontSize="26" FontWeight="SemiBold" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="运行要求" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteJava}" Foreground="{StaticResource AccentTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12" />
                                <TextBlock Text="参考内容大小" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteSize}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,12" />
                                <TextBlock Text="游戏本体、依赖和资源将一起安装，完整的已有文件会复用。" Style="{StaticResource MutedText}" FontSize="11" LineHeight="20" Margin="0,0,0,14" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}" Padding="14,12" Click="InstallVersion_Click" IsEnabled="{Binding CanInstall}" /><Button Grid.Column="1" Content="取消" Click="CancelInstall_Click" IsEnabled="{Binding CanCancelInstall}" Padding="13,12" Margin="8,0,0,0" /></Grid>
                            </StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><StackPanel><Grid><TextBlock Text="{Binding InstallStage}" FontWeight="SemiBold" /><TextBlock Text="{Binding InstallSpeed}" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" FontSize="12" /></Grid>
                            <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding InstallPercent, Mode=OneWay}" IsIndeterminate="{Binding InstallIndeterminate, Mode=OneWay}" Margin="0,10,0,8" />
                            <TextBlock Text="{Binding InstallDetail}" Style="{StaticResource MutedText}" FontSize="12" /><Grid Margin="0,8,0,0"><TextBlock Text="{Binding InstallFiles}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding InstallTransfer}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                            <Button x:Name="InstalledShortcut" Content="查看已安装版本  →" Visibility="Collapsed" Click="ShowVersions_Click" HorizontalAlignment="Left" Margin="0,13,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" />
                        </StackPanel></Border>
                        <TextBlock Grid.Row="2" Text="{Binding RemoteCountText}" Visibility="Collapsed" />
                    </Grid>
                    <Grid x:Name="ModpacksPage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="24"
                                    AllowDrop="True" DragOver="Pack_DragOver" Drop="Pack_Drop">
                                <StackPanel>
                                    <TextBlock Text="选择或拖入整合包" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="支持 Modrinth .mrpack 的原版和 Fabric 整合包。安装后，模组、配置与存档放在各自的游戏目录。"
                                               Style="{StaticResource MutedText}" Margin="0,10,0,17" />
                                    <Button Content="选择整合包文件…" Click="ChoosePack_Click" IsEnabled="{Binding CanChoosePack}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <TextBlock Text="安装位置" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding GameDirectory}" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanChoosePack}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0"
                                    Visibility="{Binding HasPack, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding PackName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding PackDetails}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    <TextBlock Text="{Binding PackFileSummary}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                    <TextBlock Text="{Binding PackFileName}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                                    <CheckBox Content="{Binding PackOptionalText}" IsChecked="{Binding IncludeOptionalPackFiles}"
                                              IsEnabled="{Binding CanImportPack}" Visibility="{Binding HasOptionalPackFiles, Converter={StaticResource BoolVisibility}}"
                                              Margin="0,12,0,0" />
                                    <WrapPanel Margin="0,14,0,0">
                                        <Button Content="安装整合包" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanImportPack}" Click="InstallPack_Click" />
                                        <Button Content="取消安装" IsEnabled="{Binding CanCancelPack}" Click="CancelPack_Click"
                                                Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                        <Button Content="返回首页启动" Click="ShowPackHome_Click"
                                                Visibility="{Binding PackCompleted, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding PackStatus}" TextWrapping="Wrap" />
                                    <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                 Value="{Binding PackPercent, Mode=OneWay}" IsIndeterminate="{Binding PackIndeterminate, Mode=OneWay}"
                                                 Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="MultiplayerPage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Background="{StaticResource HeroBrush}" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="开房邀好友" FontSize="23" FontWeight="SemiBold" />
                                    <TextBlock Text="用 MCL 启动游戏，进入单人存档，按 Esc 选择「对局域网开放」。" Style="{StaticResource MutedText}" Margin="0,8,0,0" />
                                    <TextBlock Text="{Binding LanRoomStatus}" TextWrapping="Wrap" Margin="0,10,0,14" />
                                    <WrapPanel>
                                        <Button Content="启动所选版本" Click="Launch_Click" IsEnabled="{Binding CanLaunch}" Margin="0,0,9,0" />
                                        <Button Content="创建房间" Click="HostRoom_Click" IsEnabled="{Binding CanHostRoom}" />
                                    </WrapPanel>
                                    <StackPanel Visibility="{Binding HasRoomCode, Converter={StaticResource BoolVisibility}}" Margin="0,13,0,0">
                                        <TextBlock Text="邀请码" FontWeight="SemiBold" Margin="0,0,0,5" />
                                        <DockPanel>
                                            <Button Content="复制邀请码" DockPanel.Dock="Right" Click="CopyRoom_Click" Margin="9,0,0,0" />
                                            <TextBox Text="{Binding RoomCode, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="加入好友房间" FontSize="19" FontWeight="SemiBold" />
                                    <TextBlock Text="使用与房主相同的 Java 版游戏版本和模组。支持 1.20 及以上。" Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                                    <DockPanel>
                                        <Button Content="加入并启动" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="JoinRoom_Click" IsEnabled="{Binding CanJoinRoom}" Margin="9,0,0,0" />
                                        <TextBox Text="{Binding InviteInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="128" IsEnabled="{Binding CanEditRelay}" VerticalContentAlignment="Center" AutomationProperties.Name="好友邀请码" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="{Binding MultiplayerMessage}" TextWrapping="Wrap" />
                                    <Button Content="结束联机" Click="CloseRoom_Click" HorizontalAlignment="Left" Margin="0,10,0,0"
                                            Visibility="{Binding MultiplayerActive, Converter={StaticResource BoolVisibility}}" />
                                    <Expander Header="联机服务设置" Margin="0,10,0,0">
                                        <StackPanel>
                                            <TextBlock Text="测试或自建服务时填写地址。正式发布版可预先配置。" Style="{StaticResource MutedText}" Margin="0,5,0,6" />
                                            <TextBox Text="{Binding RelayEndpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRelay}" AutomationProperties.Name="联机服务地址" />
                                        </StackPanel>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="AccountsPage" Style="{StaticResource PagePanel}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="24">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="68" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Border Width="52" Height="52" CornerRadius="10" Background="{StaticResource SoftAccentBrush}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                            <Grid><TextBlock Text="M" FontSize="25" FontWeight="Bold" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding AccountAvatar}" Visibility="{Binding HasAccountAvatar, Converter={StaticResource BoolVisibility}}" Width="40" Height="40" RenderOptions.BitmapScalingMode="NearestNeighbor" /></Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding AccountPlayerName}" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="{Binding AccountStateText}" Foreground="{StaticResource AccentTextBrush}" FontSize="12" Margin="0,5,0,0" /><TextBlock Text="{Binding AccountProfileId}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" /></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding AccountMessage}" TextWrapping="Wrap" FontSize="13" LineHeight="23" Margin="0,20,0,17" />
                                    <WrapPanel>
                                        <Button x:Name="MicrosoftSignInButton" Content="{Binding SignInButtonText}" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanSignIn}" Click="MicrosoftSignIn_Click" Margin="0,0,10,8" />
                                        <Button x:Name="CancelAccountButton" Content="取消登录" IsEnabled="{Binding CanCancelAccount}" Visibility="{Binding CanCancelAccount, Converter={StaticResource BoolVisibility}}" Click="CancelAccount_Click" Margin="0,0,10,8" />
                                        <Button x:Name="MicrosoftSignOutButton" Content="退出登录" IsEnabled="{Binding CanSignOut}" Visibility="{Binding HasMicrosoftAccount, Converter={StaticResource BoolVisibility}}" Click="MicrosoftSignOut_Click" Margin="0,0,10,8" />
                                        <Button Content="申请与接入说明" Click="OpenMicrosoftSetup_Click" Margin="0,0,10,8" />
                                        <Button Content="前往 Minecraft 官网" Click="OpenMinecraftProfile_Click" Margin="0,0,0,8" />
                                    </WrapPanel>
                                    <TextBlock Text="密码和验证码只在微软官方网页输入。MCL 使用 Windows 当前用户加密保护保存登录凭证。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0"><StackPanel>
                                <TextBlock Text="启动时使用的身份" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,16" />
                                <WrapPanel IsEnabled="{Binding CanChooseAccountMode}">
                                    <RadioButton x:Name="MicrosoftModeButton" Content="微软账号" GroupName="AccountMode" IsChecked="{Binding UseMicrosoftAccount, Mode=TwoWay}" Margin="0,0,30,8" />
                                    <RadioButton x:Name="LocalModeButton" Content="本地档案" GroupName="AccountMode" IsChecked="{Binding UseLocalAccount, Mode=TwoWay}" Margin="0,0,0,8" />
                                </WrapPanel>
                                <TextBlock Text="{Binding LaunchAccountHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,4,0,0" />
                                <TextBlock Text="微软身份启动前会联网验证；失败时会显示原因。切换到本地档案后，使用启动设置中的玩家名称。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Padding="22" Margin="0,16,0,0"><StackPanel>
                                <TextBlock Text="{Binding AccountSetupHint}" Style="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,12" />
                                <Expander x:Name="MicrosoftSetupExpander" Header="登录接入设置" Foreground="{StaticResource TextBrush}" IsExpanded="True">
                                    <StackPanel Margin="0,16,0,0">
                                        <TextBlock Text="应用（客户端）ID" FontSize="12" Margin="0,0,0,8" />
                                        <TextBox x:Name="MicrosoftClientIdInput" Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditClientId}" MaxLength="64" ToolTip="填写这个启动器自己申请的应用（客户端）ID" />
                                        <WrapPanel Margin="0,12,0,0"><Button Content="保存应用编号" IsEnabled="{Binding CanEditClientId}" Click="SaveMicrosoftConfiguration_Click" Margin="0,0,10,8" /><Button Content="查看申请步骤" Click="OpenMicrosoftSetup_Click" Margin="0,0,10,8" /><Button Content="清除保存的登录" Click="MicrosoftSignOut_Click" IsEnabled="{Binding CanChooseAccountMode}" Visibility="{Binding HasNoMicrosoftAccount, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,8" /></WrapPanel>
                                        <TextBlock Text="由启动器开发者配置，普通玩家无需申请。更换应用编号前，请先退出当前账号。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel></Border>
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="SettingsPage" Style="{StaticResource PagePanel}" IsEnabled="{Binding CanInteract}">
                        <StackPanel>
                            <Border Style="{StaticResource Card}"><StackPanel>
                                <TextBlock Text="游戏与档案" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
                                <TextBlock Text="游戏文件夹" FontSize="12" Margin="0,0,0,8" />
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择包含 versions、libraries 和 assets 的游戏目录" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <TextBlock Text="本地玩家名称" FontSize="12" Margin="0,21,0,8" /><TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" />
                                <TextBlock Text="使用 1–16 位英文字母、数字或下划线。本地档案不提供正版服务器身份认证。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                            </StackPanel></Border>
                            <Border Style="{StaticResource Card}" Margin="0,16,0,0"><StackPanel>
                                <TextBlock Text="运行环境" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,20" />
                                <Grid><TextBlock Text="Java 程序路径" FontSize="12" /><Button Content="自动检测" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{StaticResource AccentTextBrush}" HorizontalAlignment="Right" Click="DetectJava_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <Grid Margin="0,9,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseJava_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                <TextBlock Text="{Binding JavaDetail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,7,0,0" />
                                <Grid Margin="0,23,0,8"><TextBlock Text="最大游戏内存" FontSize="12" /><TextBlock Text="{Binding MemorySummary}" HorizontalAlignment="Right" Foreground="{StaticResource AccentTextBrush}" FontWeight="SemiBold" FontSize="13" /></Grid>
                                <Slider Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Foreground="{StaticResource AccentTextBrush}" />
                                <TextBlock Text="建议先使用 4096 MB，并为 Windows 和其他程序保留足够内存。" Style="{StaticResource MutedText}" FontSize="11" Margin="0,8,0,0" />
                            </StackPanel></Border>
                            <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource MutedText}" Margin="0,16,0,15" />
                        </StackPanel>
                    </Grid>
                    <Grid x:Name="LogsPage" Style="{StaticResource PagePanel}">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,15"><TextBlock Text="启动器与游戏的运行记录" Style="{StaticResource MutedText}" VerticalAlignment="Center" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="复制日志" Click="CopyLogs_Click" /><Button Content="打开日志文件夹" Margin="9,0,0,0" Click="OpenLogs_Click" /></StackPanel></Grid>
                        <Border Grid.Row="1" Background="{StaticResource LogBackgroundBrush}" CornerRadius="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="15" MinHeight="430">
                            <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" MaxHeight="550" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,4" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource LogTextBrush}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                        </Border>
                    </Grid>
                </Grid>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,13,0,0" Margin="0,15,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,15,0" VerticalAlignment="Center" /><TextBlock x:Name="FooterSlogan" Grid.Column="1" Text="为每一次出发而造" Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" /><Button x:Name="FooterSaveButton" Grid.Column="1" Content="保存设置" Visibility="Collapsed" Style="{StaticResource PrimaryButton}" Padding="18,9" Click="SaveSettings_Click" IsEnabled="{Binding CanInteract}" /></Grid></Border>
        </Grid>
    </Grid>
</Window>
