<Window x:Class="MCL.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MCL" Icon="Assets/mcl.ico" AutomationProperties.Name="MCL"
        Width="1180" Height="820" MinWidth="1020" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14"
        Closing="Window_Closing" SourceInitialized="Window_SourceInitialized" StateChanged="Window_StateChanged">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
        <Geometry x:Key="HomeIcon">M 2,9 L 10,2 18,9 M 4,8 L 4,17 16,17 16,8 M 8,17 L 8,12 12,12 12,17</Geometry>
        <Geometry x:Key="VersionsIcon">M 3,3 H 8 V 8 H 3 Z M 12,3 H 17 V 8 H 12 Z M 3,12 H 8 V 17 H 3 Z M 12,12 H 17 V 17 H 12 Z</Geometry>
        <Geometry x:Key="DownloadIcon">M 10,2 V 13 M 6,9 L 10,13 14,9 M 3,13 V 17 H 17 V 13</Geometry>
        <Geometry x:Key="PackIcon">M 3,6 L 10,2 17,6 V 14 L 10,18 3,14 Z M 3,6 L 10,10 17,6 M 10,10 V 18 M 6.5,4 L 13.5,8</Geometry>
        <Geometry x:Key="LinkIcon">M 2,7 H 17 M 13,3 L 17,7 13,11 M 18,13 H 3 M 7,9 L 3,13 7,17</Geometry>
        <Geometry x:Key="AccountIcon">M 13.5,6 A 3.5,3.5 0 1 1 6.5,6 A 3.5,3.5 0 1 1 13.5,6 M 3,17 C 3,13 6,11 10,11 C 14,11 17,13 17,17</Geometry>
        <Geometry x:Key="SettingsIcon">M 3,5 H 7 M 11,5 H 17 M 7,2 V 8 M 3,13 H 12 M 16,13 H 17 M 12,10 V 16</Geometry>
        <Geometry x:Key="LogsIcon">M 4,2 H 16 V 18 H 4 Z M 7,6 H 13 M 7,10 H 13 M 7,14 H 11</Geometry>
        <Geometry x:Key="ThemeIcon">M 10,2 L 17,8 10,18 3,8 Z M 3,8 H 17 M 7,8 L 10,18 13,8 10,2 Z</Geometry>
        <Geometry x:Key="SearchIcon">M 8.5,2.5 A 6,6 0 1 1 8.49,2.5 Z M 13.2,13.2 L 17.5,17.5</Geometry>
        <Style x:Key="ShortcutIcon" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
            <Setter Property="StrokeThickness" Value="1.55" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Width" Value="17" />
            <Setter Property="Height" Value="17" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
        <Style x:Key="WindowControlButton" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ControlBg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ControlBg" Property="Background" Value="{DynamicResource WindowControlHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowControlButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CloseBg" Background="{TemplateBinding Background}" CornerRadius="6" Margin="1,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CloseBg" Property="Background" Value="{DynamicResource CloseHoverBrush}" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavigationButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="NavBorder" Background="Transparent" CornerRadius="10" />
                    <Border x:Name="NavMarker" Width="3" VerticalAlignment="Stretch" Margin="0,10,0,10" HorizontalAlignment="Left"
                            CornerRadius="1.5" Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Margin="14,10,9,10">
                        <Path Data="{TemplateBinding CommandParameter}" Style="{StaticResource ShortcutIcon}"
                              Stroke="{TemplateBinding Foreground}" Margin="0,0,11,0" />
                        <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="NavBorder" Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                        <Setter TargetName="NavMarker" Property="Visibility" Value="Visible" />
                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="RoomRoleTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.2" CornerRadius="11">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <Border x:Name="SelectionMark" Width="26" Height="3" CornerRadius="1.5" Margin="0,0,0,5"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource HeroBorderBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                                <Setter TargetName="Surface" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HomePicker" TargetType="ComboBox">
            <Setter Property="IsEnabled" Value="{Binding CanInteract}" />
            <Setter Property="MaxDropDownHeight" Value="304" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemsPanel">
                <Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,7" Margin="4,2">
                                        <ContentPresenter />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="DropToggle" Focusable="False" ClickMode="Press" Cursor="Hand"
                                          Padding="{TemplateBinding Padding}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="PickerSurface" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource HeroBorderBrush}"
                                                BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="PickerSurface" Property="Background" Value="{DynamicResource GlassHoverBrush}" />
                                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="PickerSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <Path DockPanel.Dock="Right" Data="M 0,0 L 5,5 10,0" Stroke="{DynamicResource AccentTextBrush}"
                                          StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          VerticalAlignment="Center" Margin="13,0,0,0" />
                                    <TextBlock Text="{TemplateBinding Tag}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}"
                                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="5" AllowsTransparency="True" Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource InputBorderBrush}"
                                        BorderThickness="1" CornerRadius="11" Padding="0,3" Margin="4,0,4,6">
                                    <Border.Effect>
                                        <DropShadowEffect Color="{DynamicResource DialogShadowColor}" BlurRadius="14" ShadowDepth="2" Opacity="0.22" />
                                    </Border.Effect>
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" CanContentScroll="True">
                                        <ItemsPresenter x:Name="ItemsPresenter" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="HasItems" Value="False"><Setter Property="IsEnabled" Value="False" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HomeVersionSelector" TargetType="ComboBox" BasedOn="{StaticResource HomePicker}">
            <Setter Property="Tag" Value="{Binding SelectedVersionTitle}" />
            <Setter Property="FontSize" Value="23" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <Style x:Key="SavePreviewLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
        </Style>
        <Style x:Key="SavePreviewValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="CoverButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource GlassSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource GlassBorderBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource GlassHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VersionBadgeBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BadgeVanillaBg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="modpack">
                    <Setter Property="Background" Value="{DynamicResource BadgeModpackBg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="warning">
                    <Setter Property="Background" Value="{DynamicResource BadgeWarningBg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="VersionBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource BadgeVanillaFg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding BadgeKind}" Value="modpack">
                    <Setter Property="Foreground" Value="{DynamicResource BadgeModpackFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding BadgeKind}" Value="warning">
                    <Setter Property="Foreground" Value="{DynamicResource BadgeWarningFg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PagePanel" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /></Style>
        <Style x:Key="VersionActionButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="140" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Margin" Value="0,0,8,4" />
        </Style>
    </Window.Resources>
    <Grid x:Name="RootLayout" Background="{DynamicResource BackgroundBrush}" UseLayoutRounding="True"
          TextOptions.TextFormattingMode="Display" SizeChanged="RootLayout_SizeChanged">
        <Grid.ColumnDefinitions><ColumnDefinition Width="204" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="14,18,14,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="8,4,0,22">
                    <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource BrandBrush}">
                        <TextBlock Text="M" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="Black" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="MCL" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="Java 版启动器" FontSize="10" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Row="1">
                    <RadioButton x:Name="HomeNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Home" Checked="Navigation_Checked" Content="首页" CommandParameter="{StaticResource HomeIcon}" />
                    <RadioButton x:Name="VersionsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Versions" Checked="Navigation_Checked" Content="游戏版本" CommandParameter="{StaticResource VersionsIcon}" />
                    <RadioButton x:Name="DownloadsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Downloads" Checked="Navigation_Checked" Content="下载游戏" CommandParameter="{StaticResource DownloadIcon}" />
                    <RadioButton x:Name="ModpacksNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Modpacks" Checked="Navigation_Checked" Content="导入整合包" CommandParameter="{StaticResource PackIcon}" />
                    <RadioButton x:Name="MultiplayerNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Multiplayer" Checked="Navigation_Checked" Content="好友联机" CommandParameter="{StaticResource LinkIcon}" />
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="10,6,10,10" />
                    <RadioButton x:Name="AppearanceNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Appearance" Checked="Navigation_Checked" Content="本地角色" CommandParameter="{StaticResource AccountIcon}" />
                    <RadioButton x:Name="SettingsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Settings" Checked="Navigation_Checked" Content="启动设置" CommandParameter="{StaticResource SettingsIcon}" />
                    <RadioButton x:Name="LauncherSettingsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="LauncherSettings" Checked="Navigation_Checked" Content="启动器设置" CommandParameter="{StaticResource ThemeIcon}" />
                    <RadioButton x:Name="LogsNav" Style="{StaticResource NavigationButton}" GroupName="Navigation" Tag="Logs" Checked="Navigation_Checked" Content="运行日志" CommandParameter="{StaticResource LogsIcon}" />
                </StackPanel>
                <StackPanel Grid.Row="3">
                    <Button Click="ShowAppearance_Click" HorizontalContentAlignment="Stretch" Padding="9,8"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            ToolTip="点击管理本地角色与外观" AutomationProperties.Name="切换至本地角色设置">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <Grid Width="32" Height="32" Background="{DynamicResource SoftAccentBrush}">
                                <Grid.Clip><RectangleGeometry Rect="0,0,32,32" RadiusX="6" RadiusY="6" /></Grid.Clip>
                                <Path Data="{StaticResource AccountIcon}" Width="16" Height="16">
                                    <Path.Style>
                                        <Style TargetType="Path" BasedOn="{StaticResource ShortcutIcon}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SidebarAvatar}" Value="{x:Null}">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <Image x:Name="SidebarAvatarImage" Source="{Binding SidebarAvatar}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="9,0,4,0" VerticalAlignment="Center">
                                <Viewbox HorizontalAlignment="Left" StretchDirection="DownOnly" ToolTip="{Binding PlayerName}">
                                    <TextBlock Text="{Binding PlayerName}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                </Viewbox>
                                <TextBlock Text="本地角色" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                            <Path Grid.Column="2" Data="M 0,0 L 4,4 0,8" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center" Margin="2,0,2,0" />
                        </Grid>
                    </Button>
                    <TextBlock Text="{Binding AppVersionText, StringFormat=MCL {0}}" FontSize="10" Foreground="{DynamicResource MutedBrush}" Margin="8,9,0,0" />
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Background="Transparent">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,2,6,0">
                    <Button Style="{StaticResource WindowControlButton}" Click="MinimizeWindow_Click" ToolTip="最小化" AutomationProperties.Name="最小化">
                        <Path Data="M 0,0 H 10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" />
                    </Button>
                    <Button Style="{StaticResource WindowControlButton}" Click="MaximizeWindow_Click" ToolTip="{Binding MaximizeToolTip}" AutomationProperties.Name="最大化或还原">
                        <Grid Width="10" Height="10">
                            <Path Data="M 0.5,0.5 H 9.5 V 9.5 H 0.5 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <Path Data="M 0.5,2.5 H 7.5 V 9.5 H 0.5 Z M 2.5,2.5 V 0.5 H 9.5 V 7.5 H 7.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsWindowMaximized}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click" ToolTip="关闭" AutomationProperties.Name="关闭">
                        <Path Data="M 0,0 L 9,9 M 9,0 L 0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Button>
                </StackPanel>
            </Grid>
            <Grid Grid.Row="1" Margin="26,0,22,14">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid Margin="0,0,6,14">
                    <TextBlock Text="{Binding PageTitle}" FontSize="25" FontWeight="Bold" VerticalAlignment="Center" />
                    <Button HorizontalAlignment="Right" VerticalAlignment="Center" Click="ActivityPill_Click"
                            Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            Padding="12,6" ToolTip="点击跳转到当前任务或运行日志" AutomationProperties.Name="当前运行状态">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ActivityIsReady}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource SuccessDotBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding ActivityText}" Foreground="{DynamicResource TextBrush}" FontSize="11.5" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                </Grid>
                <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
                    <Grid x:Name="PageContent">
                        <Grid.RenderTransform><TranslateTransform x:Name="PageShift" /></Grid.RenderTransform>
                        <Grid x:Name="HomePage" Style="{StaticResource PagePanel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border CornerRadius="20" BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1" MinHeight="242"
                                    PreviewMouseLeftButtonDown="HomeCover_MouseDown">
                                <Border.Background>
                                    <ImageBrush ImageSource="{DynamicResource DefaultHomeCover}" Stretch="UniformToFill" />
                                </Border.Background>
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="选择版本背景…" Click="PickVersionCover_Click" IsEnabled="{Binding CanPickVersionCover}" />
                                        <MenuItem Header="恢复主题背景" Click="ResetVersionCover_Click" IsEnabled="{Binding HasVersionCover}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Border CornerRadius="19" IsHitTestVisible="False">
                                        <Border.Background><ImageBrush ImageSource="{Binding VersionCover}" Stretch="UniformToFill" /></Border.Background>
                                    </Border>
                                    <Border CornerRadius="19" Padding="26,20" Background="{DynamicResource HomeCoverShade}">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="56*" /><ColumnDefinition Width="44*" /></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="当前游戏" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <ComboBox x:Name="HomeVersionPicker" Style="{StaticResource HomeVersionSelector}"
                                                          ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                          ToolTip="{Binding SelectedVersionTitle}" AutomationProperties.Name="选择已安装的游戏版本" Margin="0,8,0,6">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,10,0" />
                                                                <Border Grid.Column="1" Style="{StaticResource VersionBadgeBorder}">
                                                                    <TextBlock Text="{Binding BadgeText}" Style="{StaticResource VersionBadgeText}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <TextBlock Text="{Binding SelectedVersionDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,16" />
                                                <WrapPanel>
                                                    <Button Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}" MinWidth="156" Click="Launch_Click" IsEnabled="{Binding CanLaunch}" />
                                                    <Button Content="停止游戏" Margin="8,0,0,0" Click="Stop_Click" IsEnabled="{Binding CanStop}"
                                                            Visibility="{Binding IsGameRunning, Converter={StaticResource BoolVisibility}}" />
                                                </WrapPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                    <Button Content="换背景" Style="{StaticResource CoverButton}" Click="PickVersionCover_Click"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0"
                                            ToolTip="双击卡片也可换图。右键可恢复主题背景。"
                                            Visibility="{Binding CanPickVersionCover, Converter={StaticResource BoolVisibility}}" />
                                </Grid>
                            </Border>
                            <Border x:Name="SaveCoverCard" Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0"
                                    PreviewMouseLeftButtonDown="HomeCover_MouseDown">
                                <Border.ContextMenu>
                                    <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="选择存档封面…" Click="PickSaveCover_Click" IsEnabled="{Binding HasHomeSave}" />
                                        <MenuItem Header="移除封面" Click="ResetSaveCover_Click" IsEnabled="{Binding HasSaveCover}" />
                                    </ContextMenu>
                                </Border.ContextMenu>
                                <Grid>
                                    <Border CornerRadius="15" IsHitTestVisible="False" Visibility="{Binding HasSaveCover, Converter={StaticResource BoolVisibility}}">
                                        <Border.Background><ImageBrush ImageSource="{Binding SaveCover}" Stretch="UniformToFill" /></Border.Background>
                                        <Border CornerRadius="15" Background="{DynamicResource SaveCoverShade}" />
                                    </Border>
                                    <StackPanel Margin="18,12">
                                        <DockPanel LastChildFill="False">
                                            <Button DockPanel.Dock="Right" Content="换封面" Style="{StaticResource CoverButton}" Click="PickSaveCover_Click"
                                                    ToolTip="双击卡片也可换图。可选择在游戏里按 F2 保存的截图。"
                                                    Visibility="{Binding HasHomeSave, Converter={StaticResource BoolVisibility}}" />
                                            <Button DockPanel.Dock="Right" Content="用最新截图" Style="{StaticResource CoverButton}" Click="UseLatestScreenshot_Click"
                                                    Margin="0,0,7,0" ToolTip="把本次游戏保存的最后一张截图设为当前所选存档的封面。"
                                                    Visibility="{Binding CanUseLatestScreenshot, Converter={StaticResource BoolVisibility}}" />
                                            <TextBlock Text="存档预览" FontSize="14.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <Border DockPanel.Dock="Right" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="7,2" Margin="0,0,7,0" VerticalAlignment="Center"
                                                    Visibility="{Binding HasHomeSave, Converter={StaticResource BoolVisibility}}">
                                                <TextBlock Text="{Binding HomeSaveCount}" Style="{StaticResource SavePreviewLabel}" />
                                            </Border>
                                        </DockPanel>
                                        <TextBlock Text="{Binding HomeSavesMessage}" Margin="0,7,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource SavePreviewLabel}">
                                                    <Setter Property="FontSize" Value="12" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasHomeSave}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Grid Visibility="{Binding HasHomeSave, Converter={StaticResource BoolVisibility}}">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Margin" Value="0,9,0,0" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasSaveCover}" Value="True"><Setter Property="Margin" Value="0,24,0,0" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="30*" /><ColumnDefinition Width="70*" /></Grid.ColumnDefinitions>
                                            <Grid Margin="0,0,14,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SelectedHomeSave.Name}" ToolTip="{Binding SelectedHomeSave.Name}"
                                                           FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,0,1">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasMultipleHomeSaves}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <ComboBox x:Name="HomeSavePicker" Style="{StaticResource HomePicker}" Padding="10,6" FontSize="14.5"
                                                          ItemsSource="{Binding HomeSaves}" SelectedItem="{Binding SelectedHomeSave, Mode=TwoWay}"
                                                          Tag="{Binding SelectedHomeSave.Name}" ToolTip="{Binding SelectedHomeSave.Name}"
                                                          AutomationProperties.Name="切换预览的存档"
                                                          Visibility="{Binding HasMultipleHomeSaves, Converter={StaticResource BoolVisibility}}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel ToolTip="{Binding Folder}">
                                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding LastPlayedDetail}" Style="{StaticResource SavePreviewLabel}" Margin="0,2,0,0" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </Grid>
                                            <Border Grid.Column="1" Background="{DynamicResource GlassSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                                    BorderThickness="1" CornerRadius="11" Padding="12,8" DataContext="{Binding SelectedHomeSave}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" />
                                                        <ColumnDefinition Width="1.55*" /><ColumnDefinition Width="1.55*" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,6,0">
                                                        <TextBlock Text="模式" Style="{StaticResource SavePreviewLabel}" />
                                                        <TextBlock Text="{Binding Mode}" Style="{StaticResource SavePreviewValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                                        <TextBlock Text="难度" Style="{StaticResource SavePreviewLabel}" />
                                                        <TextBlock Text="{Binding Difficulty}" Style="{StaticResource SavePreviewValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Margin="0,0,6,0" ToolTip="按世界昼夜时钟计算，初始为 0 天。">
                                                        <TextBlock Text="游戏天数" Style="{StaticResource SavePreviewLabel}" />
                                                        <TextBlock Text="{Binding DayText}" Style="{StaticResource SavePreviewValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="3" Margin="0,0,6,0" ToolTip="{Binding CreatedDetail}">
                                                        <TextBlock Text="目录创建" Style="{StaticResource SavePreviewLabel}" />
                                                        <TextBlock Text="{Binding CreatedText}" Style="{StaticResource SavePreviewValue}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="4" ToolTip="{Binding LastPlayedDetail}">
                                                        <TextBlock Text="最近游玩" Style="{StaticResource SavePreviewLabel}" />
                                                        <TextBlock Text="{Binding LastPlayedText}" Style="{StaticResource SavePreviewValue}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,12"
                                    Visibility="{Binding HasItems, ElementName=RecentGamesList, Converter={StaticResource BoolVisibility}}">
                                <StackPanel>
                                    <TextBlock Text="最近启动" FontSize="14.5" FontWeight="SemiBold" />
                                    <ItemsControl x:Name="RecentGamesList" ItemsSource="{Binding RecentGames}" Margin="0,8,0,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource ShortcutButton}" Click="ChooseRecentVersion_Click" MinHeight="48"
                                                        Padding="11,7" Margin="0,0,7,0" IsEnabled="{Binding DataContext.CanInteract, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="26" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <Path Style="{StaticResource ShortcutIcon}" Data="{StaticResource VersionsIcon}" HorizontalAlignment="Left" />
                                                        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding Version.DisplayName}" ToolTip="{Binding Version.DisplayName}"
                                                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Version.Kind}" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="2" Text="{Binding LastLaunch}" FontSize="11"
                                                                   Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,4" Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Java" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding JavaSummary}" FontWeight="SemiBold" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="分配内存" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding MemorySummary}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="本地版本" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                        <TextBlock Text="{Binding VersionCountLabel}" FontWeight="SemiBold" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="启动设置  →" Click="ShowSettings_Click" VerticalAlignment="Center" Padding="14,9" />
                                </Grid>
                            </Border>
                        </Grid>
                        <Grid x:Name="VersionsPage" Style="{StaticResource PagePanel}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="18,12">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                                        <TextBlock Text="游戏文件夹" FontWeight="SemiBold" FontSize="13" />
                                        <TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="选择文件夹" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Content="刷新" Click="RefreshVersions_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </Border>
                            <Grid x:Name="VersionsWorkspace" Grid.Row="1" Margin="0,14,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="66*" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="12,14,10,8">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                        <Grid Margin="5,0,5,11">
                                            <TextBlock Text="已安装版本" FontSize="15" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding VersionCountLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ListBox x:Name="VersionList" Grid.Row="1" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion, Mode=TwoWay}"
                                                 IsEnabled="{Binding CanInteract}" AutomationProperties.Name="已安装版本"
                                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling"
                                                 PreviewMouseWheel="VersionList_PreviewMouseWheel" PreviewMouseDown="VersionList_CancelWheelAnimation"
                                                 PreviewKeyDown="VersionList_CancelWheelAnimation">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid ToolTip="{Binding DisplayName}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <Path x:Name="VersionRowIcon" Style="{StaticResource ShortcutIcon}" Data="{StaticResource PackIcon}" HorizontalAlignment="Left" />
                                                        <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock x:Name="VersionRowKind" Text="{Binding Kind}" Foreground="{DynamicResource MutedBrush}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <Border Grid.Column="2" Style="{StaticResource VersionBadgeBorder}">
                                                            <TextBlock Text="{Binding BadgeText}" Style="{StaticResource VersionBadgeText}" />
                                                        </Border>
                                                    </Grid>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ModpackName}" Value="{x:Null}">
                                                            <Setter TargetName="VersionRowIcon" Property="Path.Data" Value="{StaticResource VersionsIcon}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                            <Setter TargetName="VersionRowKind" Property="TextBlock.Foreground" Value="{DynamicResource BadgeWarningFg}" />
                                                            <Setter TargetName="VersionRowKind" Property="TextBlock.Text" Value="需要检查" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                                <Border x:Name="VersionManagementCard" Grid.Column="2" Style="{StaticResource Card}" Padding="14" Visibility="Collapsed">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                        <StackPanel>
                                            <Border BorderBrush="{DynamicResource HeroBorderBrush}" BorderThickness="1" CornerRadius="12">
                                                <Border.Background>
                                                    <ImageBrush x:Name="VersionArtwork" ImageSource="{Binding ManagedVersionArtwork}"
                                                                Stretch="UniformToFill" AlignmentX="Right" AlignmentY="Center" />
                                                </Border.Background>
                                                <Border CornerRadius="11" MinHeight="136" Padding="18,14" Background="{DynamicResource VersionCoverShade}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="68*" /><ColumnDefinition Width="32*" /></Grid.ColumnDefinitions>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding SelectedVersion.Kind}" Foreground="{DynamicResource AccentTextBrush}" FontWeight="SemiBold" FontSize="12" />
                                                            <TextBlock Text="{Binding ManagedVersionTitle}" ToolTip="{Binding ManagedVersionTitle}" FontSize="27" FontWeight="Bold"
                                                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="76" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Border>
                                            <UniformGrid Rows="1" Margin="4,13,4,8">
                                                <StackPanel Margin="0,0,8,0">
                                                    <TextBlock Text="Minecraft 版本" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding ManagedMinecraftVersion}" ToolTip="{Binding ManagedMinecraftVersion}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="加载器" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding ManagedVersionLoader}" ToolTip="{Binding ManagedVersionLoader}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel Margin="8,0,0,0" Visibility="{Binding ManagedVersionHasPackVersion, Converter={StaticResource BoolVisibility}}">
                                                    <TextBlock Text="整合包版本" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding SelectedVersion.ModpackVersion}" ToolTip="{Binding SelectedVersion.ModpackVersion}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Java 环境" Foreground="{DynamicResource MutedBrush}" FontSize="11" />
                                                    <TextBlock Text="{Binding VersionJavaText}" ToolTip="{Binding VersionJavaText}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding VersionNeedsJava}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </UniformGrid>
                                            <TextBlock Text="{Binding SelectedVersion.Issue}" Style="{StaticResource MutedText}" Foreground="{DynamicResource AccentTextBrush}"
                                                       Visibility="{Binding ManagedVersionNeedsAttention, Converter={StaticResource BoolVisibility}}" Margin="4,0,4,8" />
                                            <WrapPanel Margin="4,5,4,13">
                                                <Button x:Name="LaunchSelectedVersionButton" Content="{Binding LaunchButtonText}" Style="{StaticResource PrimaryButton}"
                                                        Height="44" MinWidth="154" Click="Launch_Click" IsEnabled="{Binding CanLaunch}" Margin="0,0,8,4" />
                                                <Button x:Name="InstallVersionJavaButton" Content="{Binding InstallJavaButtonText}" Height="44" MinWidth="138"
                                                        Click="InstallVersionJava_Click" IsEnabled="{Binding CanInteract}" Margin="0,0,8,4"
                                                        Visibility="{Binding VersionNeedsJava, Converter={StaticResource BoolVisibility}}"
                                                        ToolTip="从 Minecraft 官方下载运行环境，安装到 MCL 的专用目录。" />
                                            </WrapPanel>
                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="4,11,4,0">
                                                <StackPanel>
                                                    <TextBlock Text="版本文件" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ManagedVersionPath}" Foreground="{DynamicResource MutedBrush}"
                                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,8">
                                                        <TextBlock.ToolTip><TextBlock Text="{Binding ManagedVersionPath}" MaxWidth="380" TextWrapping="Wrap" /></TextBlock.ToolTip>
                                                    </TextBlock>
                                                    <WrapPanel>
                                                        <Button Content="打开版本文件夹" Style="{StaticResource VersionActionButton}" Click="OpenVersionFolder_Click" IsEnabled="{Binding CanOpenVersionFolder}" />
                                                        <Button Content="检查并修复游戏" Style="{StaticResource VersionActionButton}" Click="RepairVersion_Click" IsEnabled="{Binding CanRepairVersion}"
                                                                ToolTip="检查官方客户端、依赖、资源和日志配置，只补齐缺失或损坏的官方文件。" ToolTipService.ShowOnDisabled="True" />
                                                        <Button Content="导出整合包" Style="{StaticResource VersionActionButton}" Click="ExportModpack_Click" IsEnabled="{Binding CanShareModpack}"
                                                                Visibility="{Binding ManagedVersionIsModpack, Converter={StaticResource BoolVisibility}}"
                                                                ToolTip="分享包包含模组、配置和资源包。请在发送前检查打包内容。" />
                                                    </WrapPanel>
                                                    <StackPanel Margin="0,7,0,4" Visibility="{Binding IsRepairing, Converter={StaticResource BoolVisibility}}">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="取消" Click="CancelRepair_Click" Padding="9,4" Margin="8,0,0,0" />
                                                            <TextBlock Text="{Binding RepairStatus}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                                        </DockPanel>
                                                        <ProgressBar Height="6" Margin="0,7,0,0" Maximum="100" Value="{Binding RepairPercent, Mode=OneWay}"
                                                                     IsIndeterminate="{Binding RepairIndeterminate, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <TextBlock Text="存档" FontSize="13" FontWeight="SemiBold" Margin="0,11,0,0" />
                                                    <TextBlock Text="{Binding SaveScopeHint}" Foreground="{DynamicResource MutedBrush}"
                                                               TextWrapping="Wrap" FontSize="11" Margin="0,4,0,7" />
                                                    <WrapPanel>
                                                        <Button Content="备份为 ZIP" Style="{StaticResource VersionActionButton}" Click="BackupSaves_Click" IsEnabled="{Binding CanManageSaves}"
                                                                ToolTip="将存档保存为 ZIP，可在保存窗口选择位置。" />
                                                        <Button Content="从 ZIP 恢复" Style="{StaticResource VersionActionButton}" Click="RestoreSaves_Click" IsEnabled="{Binding CanManageSaves}"
                                                                ToolTip="还原备份中的存档，并在旁边保留恢复前的存档。" />
                                                        <Button Content="打开默认备份目录" Style="{StaticResource VersionActionButton}" Click="OpenSaveBackups_Click" ToolTip="{Binding SaveBackupDirectory}" />
                                                    </WrapPanel>
                                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,9,0,0">
                                                        <Button x:Name="DeleteVersionButton" Content="删除版本" Style="{StaticResource DangerButton}"
                                                                HorizontalAlignment="Right" ToolTip="{Binding VersionManagementHint}" ToolTipService.ShowOnDisabled="True"
                                                                Click="DeleteSelectedVersion_Click" IsEnabled="{Binding CanDeleteVersion}" />
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                            <Border x:Name="EmptyVersions" Grid.Row="1" Style="{StaticResource Card}" MinHeight="290" Margin="0,14,0,0">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Data="{StaticResource VersionsIcon}" Style="{StaticResource ShortcutIcon}" Width="26" Height="26" />
                                    <TextBlock Text="还没有发现游戏版本" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,5" />
                                    <TextBlock Text="下载一个原版版本，或导入你已有的整合包。" Style="{StaticResource MutedText}" TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                        <Button Content="下载游戏" Style="{StaticResource PrimaryButton}" Click="ShowDownloads_Click" />
                                        <Button Content="导入整合包" Click="ShowModpacks_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                        <Grid x:Name="DownloadsPage" Style="{StaticResource PagePanel}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="游戏安装位置" FontWeight="SemiBold" /><TextBlock Text="{Binding GameDirectory}" ToolTip="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis" Margin="0,5,16,0" /></StackPanel>
                                <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                            </Grid></Border>
                            <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="310" /></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <Grid Margin="0,0,0,12"><TextBlock Text="原版游戏版本" FontSize="15" FontWeight="SemiBold" /><Button Content="刷新列表" HorizontalAlignment="Right" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" Click="RefreshRemote_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                    <StackPanel Grid.Row="1" Margin="0,0,0,12">
                                        <Grid>
                                            <TextBox Text="{Binding VersionSearch, UpdateSourceTrigger=PropertyChanged}" Padding="34,9,12,9" AutomationProperties.Name="搜索下载版本" IsEnabled="{Binding CanInteract}" />
                                            <Path Data="{StaticResource SearchIcon}" Stroke="{DynamicResource MutedBrush}" StrokeThickness="1.6"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="14" Height="14" Stretch="Uniform"
                                                  HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                                            <TextBlock Text="搜索版本号，例如 1.21.4 或 1.8.9" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="35,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding VersionSearch}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding RemoteCountText}" Style="{StaticResource MutedText}" FontSize="11.5" VerticalAlignment="Center" />
                                            <CheckBox Content="显示快照和预发布版" IsChecked="{Binding ShowSnapshots}" IsEnabled="{Binding CanInteract}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </StackPanel>
                                    <Grid Grid.Row="2" MinHeight="210">
                                        <ListBox x:Name="RemoteVersionList" ItemsSource="{Binding AvailableVersions}" SelectedItem="{Binding SelectedRemoteVersion, Mode=TwoWay}" SelectionChanged="RemoteVersion_SelectionChanged" IsEnabled="{Binding CanInteract}" MaxHeight="290"
                                                 VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Id}" FontSize="15" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding ReleaseDateText}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,0" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center" Margin="10,0,0,0" Background="{DynamicResource SoftAccentBrush}">
                                                            <TextBlock Text="{Binding KindText}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border x:Name="EmptyRemote" Background="{DynamicResource PanelBrush}" Padding="12">
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="等待版本列表" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" />
                                                <TextBlock Text="点击刷新，从官方获取可安装的版本。&#10;搜索无结果时，可以换一个版本号。" Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,8,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Grid></Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20"><StackPanel>
                                    <TextBlock Text="即将安装" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteVersionTitle}" FontSize="25" FontWeight="Bold" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="运行要求" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteJava}" Foreground="{DynamicResource AccentTextBrush}" FontSize="13" TextWrapping="Wrap" Margin="0,4,0,12" />
                                    <TextBlock Text="参考内容大小" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding RemoteSize}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,12" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Button Content="{Binding InstallButtonText}" Style="{StaticResource PrimaryButton}" Padding="14,12" Click="InstallVersion_Click" IsEnabled="{Binding CanInstall}" /><Button Grid.Column="1" Content="取消" Click="CancelInstall_Click" IsEnabled="{Binding CanCancelInstall}" Padding="13,12" Margin="8,0,0,0" /></Grid>
                                </StackPanel></Border>
                            </Grid>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="16"><StackPanel><Grid><TextBlock Text="{Binding InstallStage}" FontWeight="SemiBold" /><TextBlock Text="{Binding InstallSpeed}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" FontSize="12" /></Grid>
                                <ProgressBar Height="7" Minimum="0" Maximum="100" Value="{Binding InstallPercent, Mode=OneWay}" IsIndeterminate="{Binding InstallIndeterminate, Mode=OneWay}" Margin="0,10,0,8" />
                                <TextBlock Text="{Binding InstallDetail}" Style="{StaticResource MutedText}" FontSize="12" /><Grid Margin="0,8,0,0"><TextBlock Text="{Binding InstallFiles}" Style="{StaticResource MutedText}" FontSize="11" /><TextBlock Text="{Binding InstallTransfer}" Style="{StaticResource MutedText}" FontSize="11" HorizontalAlignment="Right" /></Grid>
                                <Button x:Name="InstalledShortcut" Content="查看已安装版本  →" Visibility="Collapsed" Click="ShowVersions_Click" HorizontalAlignment="Left" Margin="0,12,0,0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel></Border>
                        </Grid>
                        <Grid x:Name="ModpacksPage" Style="{StaticResource PagePanel}">
                            <StackPanel>
                                <Border Padding="12" AllowDrop="True"
                                        DragEnter="Pack_DragOver" DragOver="Pack_DragOver" DragLeave="Pack_DragLeave" Drop="Pack_Drop">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Card}">
                                            <Setter Property="Background" Value="{DynamicResource HeroBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPackDragOver}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource SoftAccentBrush}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Rectangle RadiusX="12" RadiusY="12" StrokeThickness="1.5" StrokeDashArray="5 4" IsHitTestVisible="False">
                                            <Rectangle.Style>
                                                <Style TargetType="Rectangle">
                                                    <Setter Property="Stroke" Value="{DynamicResource HeroBorderBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPackDragOver}" Value="True">
                                                            <Setter Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Rectangle.Style>
                                        </Rectangle>
                                        <StackPanel HorizontalAlignment="Center" Margin="20,22">
                                            <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource PanelBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                                <Path Data="{StaticResource PackIcon}" Style="{StaticResource ShortcutIcon}" Width="22" Height="22" />
                                            </Border>
                                            <TextBlock FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,0">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="拖入整合包文件，或点击选择" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPackDragOver}" Value="True">
                                                                <Setter Property="Text" Value="松开鼠标导入这个整合包" />
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="支持 Modrinth .mrpack（原版、Fabric）和 CurseForge ZIP（原版、Fabric、Forge 1.20.1）。"
                                                       Style="{StaticResource MutedText}" TextAlignment="Center" Margin="0,6,0,15" />
                                            <Button Content="选择整合包文件…" Style="{StaticResource PrimaryButton}" Click="ChoosePack_Click"
                                                    IsEnabled="{Binding CanChoosePack}" HorizontalAlignment="Center" Padding="20,10" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,14,0">
                                            <TextBlock Text="安装位置" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding GameDirectory}" Style="{StaticResource MutedText}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding GameDirectory}" Margin="0,5,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="更改位置" Click="BrowseInstallFolder_Click" IsEnabled="{Binding CanChoosePack}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="20" Margin="0,14,0,0"
                                        Visibility="{Binding HasPack, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PackName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PackDetails}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding PackFileSummary}" Style="{StaticResource MutedText}" Margin="0,7,0,0" />
                                        <TextBlock Text="{Binding PackFileName}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                                        <CheckBox Content="{Binding PackOptionalText}" IsChecked="{Binding IncludeOptionalPackFiles}"
                                                  IsEnabled="{Binding CanImportPack}" Visibility="{Binding HasOptionalPackFiles, Converter={StaticResource BoolVisibility}}"
                                                  Margin="0,12,0,0" />
                                        <WrapPanel Margin="0,14,0,0">
                                            <Button Content="安装整合包" Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanImportPack}" Click="InstallPack_Click" />
                                            <Button Content="选择补充文件夹" Click="ChoosePackLocalFiles_Click" IsEnabled="{Binding CanImportPack}"
                                                    Visibility="{Binding IsCurseForgePack, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                            <Button Content="取消安装" IsEnabled="{Binding CanCancelPack}" Click="CancelPack_Click"
                                                    Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                            <Button Content="返回首页启动" Click="ShowPackHome_Click"
                                                    Visibility="{Binding PackCompleted, Converter={StaticResource BoolVisibility}}" Margin="9,0,0,0" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding PackStatus}" TextWrapping="Wrap" />
                                        <ProgressBar Height="6" Margin="0,10,0,0" Minimum="0" Maximum="100"
                                                     Value="{Binding PackPercent, Mode=OneWay}" IsIndeterminate="{Binding PackIndeterminate, Mode=OneWay}"
                                                     Visibility="{Binding PackInProgress, Converter={StaticResource BoolVisibility}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="MultiplayerPage" Style="{StaticResource PagePanel}">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="5" Margin="0,0,0,14">
                                    <Grid IsEnabled="{Binding CanEditRelay}" KeyboardNavigation.DirectionalNavigation="Cycle">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" /><ColumnDefinition Width="6" /><ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="HostRoleButton" Content="创建房间" Style="{StaticResource RoomRoleTab}" GroupName="MultiplayerRole"
                                                     IsChecked="{Binding ShowHostSetup, Mode=TwoWay}" />
                                        <RadioButton x:Name="GuestRoleButton" Grid.Column="2" Content="加入房间" Style="{StaticResource RoomRoleTab}" GroupName="MultiplayerRole"
                                                     IsChecked="{Binding ShowGuestSetup, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                                <Grid x:Name="HostRoomCard" Visibility="{Binding ShowHostSetup, Converter={StaticResource BoolVisibility}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="64*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource Card}" Padding="14">
                                        <DockPanel>
                                            <TextBlock Text="选择游戏版本" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" Margin="2,0,0,10" />
                                            <Grid>
                                                <ListBox x:Name="HostVersionList" ItemsSource="{Binding HostRoomVersions}"
                                                         SelectedItem="{Binding HostRoomVersion, Mode=TwoWay}"
                                                         IsEnabled="{Binding CanChooseHostVersion}" AutomationProperties.Name="选择开房版本"
                                                         MaxHeight="166" VerticalAlignment="Top" VirtualizingPanel.ScrollUnit="Pixel"
                                                         IsVisibleChanged="HostVersionList_IsVisibleChanged">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid ToolTip="{Binding DisplayName}">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                                                                <Border Grid.Column="1" Style="{StaticResource VersionBadgeBorder}">
                                                                    <TextBlock Text="{Binding BadgeText}" Style="{StaticResource VersionBadgeText}" />
                                                                </Border>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                </ListBox>
                                                <TextBlock Text="暂无可联机版本" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasItems, ElementName=HostVersionList}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Padding="20">
                                        <StackPanel>
                                            <TextBlock Text="房间设置" FontSize="17" FontWeight="SemiBold" />
                                            <CheckBox x:Name="Ipv6DirectOption" Content="使用 IPv6 直连（测试）" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding UseIpv6Direct}" IsEnabled="{Binding CanEditRelay}" Margin="0,10,0,8" />
                                            <CheckBox Content="使用手动中转" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding UseSharedRelay}" IsEnabled="{Binding CanChooseSharedRelay}" />
                                            <TextBlock Text="{Binding HostTransportHint}" Style="{StaticResource MutedText}" Margin="0,9,0,0" />
                                            <TextBlock Text="{Binding LanRoomStatus}" TextWrapping="Wrap">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Margin" Value="0,6,0,0" />
                                                        <Style.Triggers>
                                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Button Content="{Binding HostRoomButtonText}" Style="{StaticResource PrimaryButton}" Click="HostRoom_Click"
                                                    IsEnabled="{Binding CanHostRoom}" HorizontalAlignment="Left" Margin="0,12,0,0" />
                                            <StackPanel Visibility="{Binding HasRoomCode, Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
                                                <TextBlock Text="邀请码" FontWeight="SemiBold" Margin="0,0,0,5" />
                                                <DockPanel>
                                                    <Button Content="复制邀请码" DockPanel.Dock="Right" Click="CopyRoom_Click" Margin="9,0,0,0" />
                                                    <TextBox Text="{Binding RoomCode, Mode=OneWay}" IsReadOnly="True" VerticalContentAlignment="Center" AutomationProperties.Name="房间邀请码" />
                                                </DockPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border x:Name="GuestRoomCard" Style="{StaticResource Card}" Padding="20"
                                        Visibility="{Binding ShowGuestSetup, Converter={StaticResource BoolVisibility}}">
                                    <StackPanel>
                                        <TextBlock Text="加入好友房间" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="使用与房主相同的 Java 版游戏版本和模组。支持 1.20 及以上。" Style="{StaticResource MutedText}" Margin="0,6,0,10" />
                                        <DockPanel>
                                            <Button x:Name="JoinRoomButton" Content="{Binding JoinRoomButtonText}" DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Click="JoinRoom_Click" IsEnabled="{Binding CanJoinRoom}" Margin="9,0,0,0" />
                                            <Grid>
                                                <TextBox Text="{Binding InviteInput, UpdateSourceTrigger=PropertyChanged}" MaxLength="160" IsEnabled="{Binding CanEditRelay}" VerticalContentAlignment="Center" AutomationProperties.Name="好友邀请码" />
                                                <TextBlock Text="粘贴好友邀请码" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="12,0"
                                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding InviteInput}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </DockPanel>
                                        <Button Content="对比好友分享包" Click="CompareModpack_Click" IsEnabled="{Binding CanCompareModpack}"
                                                HorizontalAlignment="Left" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{Binding MultiplayerStage}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding MultiplayerStatus}" TextWrapping="Wrap" Margin="0,0,0,8">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Button Content="结束联机" Click="CloseRoom_Click" HorizontalAlignment="Left" Margin="0,2,0,10"
                                                Visibility="{Binding MultiplayerActive, Converter={StaticResource BoolVisibility}}" />
                                        <DockPanel Margin="0,0,0,9" Visibility="{Binding HasRoomDiagnostic, Converter={StaticResource BoolVisibility}}">
                                            <Button DockPanel.Dock="Right" Content="复制诊断" Click="CopyRoomDiagnostic_Click" Padding="10,5"
                                                    ToolTip="复制连接方式、步骤和错误类别。" />
                                            <TextBlock Text="{Binding RoomDiagnosticRoute}" Style="{StaticResource MutedText}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <Expander Header="本次连接步骤" Margin="0,0,0,8"
                                                  Visibility="{Binding HasRoomDiagnostic, Converter={StaticResource BoolVisibility}}">
                                            <TextBlock Text="{Binding RoomDiagnosticDetails}" Style="{StaticResource MutedText}" Margin="0,5,0,0" />
                                        </Expander>
                                        <Expander Header="手动中转设置" IsEnabled="{Binding CanEditRelay}">
                                            <StackPanel>
                                                <TextBlock Text="已有共享中转或收到旧版邀请码时，可填写地址。" Style="{StaticResource MutedText}" Margin="0,2,0,8" />
                                                <TextBox Text="{Binding RelayEndpoint, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanEditRelay}" AutomationProperties.Name="联机服务地址" />
                                            </StackPanel>
                                        </Expander>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="RoomLatencyCard" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="最近 30 次" DockPanel.Dock="Right" Style="{StaticResource MutedText}"
                                                       FontSize="11" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            <TextBlock Text="联机延迟" FontSize="16" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding RoomLatencyCaption}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,2,0,9"
                                                   ToolTip="中转测速测量到入口的 HTTP 往返。IPv6 测速测量双方启动器之间的往返。" />
                                        <UniformGrid Rows="1" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="当前延迟" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding RoomLatencyCurrent}" Foreground="{DynamicResource AccentTextBrush}" FontSize="22" FontWeight="SemiBold" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="平均延迟" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding RoomLatencyAverage}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel ToolTip="相邻有效样本的平均变化。">
                                                <TextBlock Text="波动" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding RoomLatencyJitter}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="未响应" Style="{StaticResource MutedText}" FontSize="11" />
                                                <TextBlock Text="{Binding RoomLatencyMissed}" FontSize="17" FontWeight="SemiBold" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <Border Background="{DynamicResource SubtleSurfaceBrush}" CornerRadius="10" Padding="8,5">
                                            <Grid Height="92" ClipToBounds="True" AutomationProperties.Name="实时延迟趋势，最新采样在右侧">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="58" />
                                                </Grid.ColumnDefinitions>
                                                <Viewbox Stretch="Fill" IsHitTestVisible="False">
                                                    <Canvas Width="740" Height="92">
                                                        <Line X1="7" Y1="6" X2="732" Y2="6" Stroke="{DynamicResource DividerBrush}" />
                                                        <Line X1="7" Y1="45" X2="732" Y2="45" Stroke="{DynamicResource DividerBrush}" StrokeDashArray="3,3" />
                                                        <Line X1="7" Y1="84" X2="732" Y2="84" Stroke="{DynamicResource DividerBrush}" />
                                                        <Path Data="{Binding RoomLatencyCurve}" Stroke="{DynamicResource AccentBrush}"
                                                              Fill="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                                                        <Path Data="{Binding RoomLatencyTimeoutMarks}" Fill="{DynamicResource BadgeWarningFg}" />
                                                    </Canvas>
                                                </Viewbox>
                                                <Grid Grid.Column="1" Margin="2,0,2,0" TextBlock.Foreground="{DynamicResource MutedBrush}" TextBlock.FontSize="10.5">
                                                    <TextBlock Text="{Binding RoomLatencyChartTop}" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                                    <TextBlock Text="{Binding RoomLatencyChartMiddle}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <TextBlock Text="0 ms" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="AppearancePage" Style="{StaticResource PagePanel}">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Padding="20">
                                    <StackPanel IsEnabled="{Binding CanEditLocalAppearance}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="58*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Style="{StaticResource Card}" Padding="12">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="*" /><RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border x:Name="CharacterStage" CornerRadius="11" Cursor="Hand"
                                                            MouseLeftButtonDown="CharacterPreview_MouseDown" MouseMove="CharacterPreview_MouseMove"
                                                            MouseLeftButtonUp="CharacterPreview_MouseUp" AutomationProperties.Name="角色 3D 预览"
                                                            ToolTip="拖动角色旋转">
                                                        <Border.Background><DynamicResource ResourceKey="CharacterStageBrush" /></Border.Background>
                                                        <Viewport3D x:Name="CharacterViewport" MaxWidth="260" MinHeight="264" IsHitTestVisible="False" ClipToBounds="True">
                                                            <Viewport3D.Camera>
                                                                <OrthographicCamera Position="0,0,96" LookDirection="0,0,-1" UpDirection="0,1,0" Width="34" />
                                                            </Viewport3D.Camera>
                                                            <ModelVisual3D>
                                                                <ModelVisual3D.Content>
                                                                    <Model3DGroup>
                                                                        <AmbientLight Color="#FFC0C0C0" />
                                                                        <DirectionalLight Color="#FF686868" Direction="-1,-2,-3" />
                                                                        <DirectionalLight Color="#FF383838" Direction="1,-1,2" />
                                                                    </Model3DGroup>
                                                                </ModelVisual3D.Content>
                                                            </ModelVisual3D>
                                                            <ModelVisual3D x:Name="CharacterVisual">
                                                                <ModelVisual3D.Transform>
                                                                    <Transform3DGroup>
                                                                        <RotateTransform3D>
                                                                            <RotateTransform3D.Rotation>
                                                                                <AxisAngleRotation3D x:Name="CharacterYaw" Axis="0,1,0" Angle="18" />
                                                                            </RotateTransform3D.Rotation>
                                                                        </RotateTransform3D>
                                                                        <RotateTransform3D>
                                                                            <RotateTransform3D.Rotation>
                                                                                <AxisAngleRotation3D x:Name="CharacterPitch" Axis="1,0,0" Angle="8" />
                                                                            </RotateTransform3D.Rotation>
                                                                        </RotateTransform3D>
                                                                    </Transform3DGroup>
                                                                </ModelVisual3D.Transform>
                                                            </ModelVisual3D>
                                                        </Viewport3D>
                                                    </Border>
                                                    <StackPanel Grid.Row="1">
                                                        <WrapPanel HorizontalAlignment="Center" Margin="0,9,0,0">
                                                            <Button Content="正面" Click="ShowCharacterFront_Click" Padding="12,5" Margin="0,0,6,0"
                                                                    AutomationProperties.Name="查看角色正面" />
                                                            <Button Content="背面" Click="ShowCharacterBack_Click" Padding="12,5"
                                                                    AutomationProperties.Name="查看角色背面" />
                                                        </WrapPanel>
                                                        <TextBlock Text="{Binding PublicAppearanceName, StringFormat=正在预览 · {0}}"
                                                                   Visibility="{Binding IsPreviewingPublicAppearance, Converter={StaticResource BoolVisibility}}"
                                                                   Foreground="{DynamicResource AccentTextBrush}" FontSize="11"
                                                                   HorizontalAlignment="Center" Margin="0,5,0,0" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                            <DockPanel Grid.Column="2" LastChildFill="True">
                                                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                                                    <CheckBox Content="启动时应用本地外观" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding ApplyLocalAppearance}"
                                                              ToolTip="自定义外观仅在本机显示。首次使用需要联网安装外观组件。" />
                                                    <DockPanel Margin="0,9,0,0">
                                                        <Button DockPanel.Dock="Right" Content="保存本地角色" Style="{StaticResource PrimaryButton}" Click="SaveLocalAppearance_Click" />
                                                        <TextBlock Text="{Binding LocalAppearanceStatus}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11" />
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel>
                                                    <Border Style="{StaticResource Card}" Padding="13">
                                                        <StackPanel>
                                                            <TextBlock Text="游戏内 ID（玩家名）" FontWeight="SemiBold" Margin="0,0,0,6" />
                                                            <TextBox x:Name="LocalPlayerNameBox" Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16"
                                                                     AutomationProperties.Name="游戏内玩家名"
                                                                     ToolTip="1–16 位英文字母、数字或下划线。改名后，部分存档会将新 ID 识别为另一名玩家。" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Card}" Padding="13" Margin="0,10,0,0">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                    <Button Content="选择 PNG" Click="PickLocalSkin_Click" Padding="9,6" Margin="0,0,6,0" />
                                                                    <Button Content="清除" Click="ClearLocalSkin_Click" Padding="8,6" IsEnabled="{Binding HasLocalSkin}" />
                                                                </StackPanel>
                                                                <TextBlock Text="皮肤" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                            </DockPanel>
                                                            <CheckBox IsChecked="{Binding UseSlimSkin}" IsEnabled="{Binding HasLocalSkin}" Margin="0,8,0,0">
                                                                <TextBlock Text="使用细手臂模型（Alex）" TextWrapping="Wrap" />
                                                            </CheckBox>
                                                            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                                                <DockPanel>
                                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                                        <Button Content="选择 PNG" Click="PickLocalCape_Click" Padding="9,6" Margin="0,0,6,0" />
                                                                        <Button Content="清除" Click="ClearLocalCape_Click" Padding="8,6" IsEnabled="{Binding HasLocalCape}" />
                                                                    </StackPanel>
                                                                    <TextBlock Text="披风" FontWeight="SemiBold" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                                </DockPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Card}" Padding="13" Margin="0,10,0,0">
                                                        <StackPanel>
                                                            <TextBlock Text="按 Java 玩家名导入" FontWeight="SemiBold" />
                                                            <Grid Margin="0,7,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBox Text="{Binding PublicPlayerName, UpdateSourceTrigger=PropertyChanged}"
                                                                         MaxLength="16" KeyDown="PublicPlayerNameBox_KeyDown"
                                                                         AutomationProperties.Name="要查询的 Java 玩家名" />
                                                                <Button Grid.Column="1" Content="查询" Click="LookupPublicAppearance_Click" Margin="8,0,0,0" />
                                                            </Grid>
                                                            <TextBlock Text="{Binding PublicAppearanceStatus}" Foreground="{DynamicResource MutedBrush}" FontSize="11"
                                                                       TextWrapping="Wrap" Margin="0,5,0,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Style.Triggers>
                                                                            <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <StackPanel Visibility="{Binding HasPublicAppearance, Converter={StaticResource BoolVisibility}}" Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding PublicAppearanceName}" FontWeight="SemiBold" />
                                                                <TextBox Text="{Binding PublicAppearanceUuid, Mode=OneWay}" IsReadOnly="True"
                                                                         FontSize="11" Margin="0,5,0,0" AutomationProperties.Name="公开角色 UUID" />
                                                                <WrapPanel Margin="0,7,0,0">
                                                                    <Button Content="导入外观" Click="ImportPublicAppearance_Click" IsEnabled="{Binding HasPublicTextures}"
                                                                            Padding="9,5" Margin="0,0,6,5" />
                                                                    <Button Content="使用玩家名" Click="UsePublicPlayerName_Click" Padding="9,5" Margin="0,0,6,5" />
                                                                    <Button Content="{Binding PublicPreviewButtonLabel}" Click="TogglePublicAppearancePreview_Click"
                                                                            IsEnabled="{Binding HasPublicTextures}" Padding="9,5" Margin="0,0,0,5" />
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </DockPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                                    <Expander Header="从正版账号导入">
                                        <StackPanel>
                                            <TextBlock Text="登录微软账号，获取 Minecraft Java 版角色资料。游戏使用已保存的本地角色启动。"
                                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,2,0,12" />
                                            <WrapPanel>
                                                <Button x:Name="ProfileSignInButton" Content="登录微软账号" Click="SignInForProfile_Click"
                                                        IsEnabled="{Binding CanSignInForProfile}" Margin="0,0,8,7" />
                                                <Button x:Name="ProfileRefreshButton" Content="刷新资料" Click="RefreshOnlineProfile_Click"
                                                        IsEnabled="{Binding CanRefreshOnlineProfile}"
                                                        Visibility="{Binding HasOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,7" />
                                                <Button x:Name="ProfileClearButton" Content="清除登录" Click="ClearOnlineProfile_Click"
                                                        Visibility="{Binding CanClearOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,0,8,7" />
                                                <Button Content="取消" Click="CancelProfileOperation_Click"
                                                        Visibility="{Binding CanCancelProfileOperation, Converter={StaticResource BoolVisibility}}" Margin="0,0,0,7" />
                                            </WrapPanel>
                                            <StackPanel Visibility="{Binding HasOnlineProfile, Converter={StaticResource BoolVisibility}}" Margin="0,7,0,5">
                                                <TextBlock Text="{Binding OnlineProfileName}" FontSize="18" FontWeight="SemiBold" />
                                                <TextBlock Text="角色 UUID" Style="{StaticResource MutedText}" Margin="0,6,0,5" />
                                                <TextBox Text="{Binding OnlineProfileId, Mode=OneWay}" IsReadOnly="True" AutomationProperties.Name="角色 UUID" />
                                                <TextBlock Text="{Binding OnlineAppearanceSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,8" />
                                                <WrapPanel>
                                                    <Button x:Name="ProfileNameButton" Content="使用这个昵称" Click="UseOnlineName_Click"
                                                            IsEnabled="{Binding CanUseOnlineName}" Margin="0,0,8,7" />
                                                    <Button x:Name="ProfileSkinButton" Content="导入当前皮肤" Click="ImportOnlineSkin_Click"
                                                            IsEnabled="{Binding CanImportOnlineSkin}" Margin="0,0,8,7" />
                                                    <Button x:Name="ProfileCapeButton" Content="导入当前披风" Click="ImportOnlineCape_Click"
                                                            IsEnabled="{Binding CanImportOnlineCape}" Margin="0,0,0,7" />
                                                </WrapPanel>
                                            </StackPanel>
                                            <TextBlock Text="{Binding OnlineProfileStatus}" Style="{StaticResource MutedText}"
                                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                                            <Expander Header="启动器应用 ID" IsEnabled="{Binding CanEditLocalAppearance}">
                                                <StackPanel Margin="0,4,0,0">
                                                    <TextBlock Text="填写已取得 Minecraft 接口访问许可的应用（客户端）ID。"
                                                               Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                                    <TextBox Text="{Binding MicrosoftClientId, UpdateSourceTrigger=PropertyChanged}" MaxLength="64"
                                                             AutomationProperties.Name="启动器应用 ID" />
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </Expander>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="SettingsPage" Style="{StaticResource PagePanel}" IsEnabled="{Binding CanInteract}">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="18,15"><StackPanel>
                                    <TextBlock Text="游戏与档案" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <TextBlock Text="游戏文件夹" FontSize="12" Margin="0,0,0,5" />
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding GameDirectory, UpdateSourceTrigger=PropertyChanged}" ToolTip="选择包含 versions、libraries 和 assets 的游戏目录" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseGame_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                    <TextBlock Text="本地玩家名称" FontSize="12" Margin="0,12,0,5" />
                                    <TextBox Text="{Binding PlayerName, UpdateSourceTrigger=PropertyChanged}" MaxLength="16" AutomationProperties.Name="本地玩家名称"
                                             ToolTip="1–16 位英文字母、数字或下划线。改名后，部分存档会将新 ID 识别为另一名玩家。" />
                                </StackPanel></Border>
                                <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0"><StackPanel>
                                    <TextBlock Text="运行环境" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,11" />
                                    <Grid>
                                        <CheckBox Content="根据游戏版本自动匹配 Java" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoMatchJava}" VerticalAlignment="Center" />
                                        <Button Content="重新检测" Padding="8,4" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource AccentTextBrush}" HorizontalAlignment="Right" Click="DetectJava_Click" IsEnabled="{Binding CanInteract}" />
                                    </Grid>
                                    <TextBlock Text="自定义 Java 路径（可选）" FontSize="12" Margin="0,10,0,0" />
                                    <Grid Margin="0,6,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox Text="{Binding JavaPath, UpdateSourceTrigger=PropertyChanged}" /><Button Grid.Column="1" Content="浏览…" Margin="10,0,0,0" Click="BrowseJava_Click" IsEnabled="{Binding CanInteract}" /></Grid>
                                    <TextBlock Text="{Binding JavaDetail}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,5,0,0" />
                                    <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,11" />
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="最大游戏内存" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding MemorySummary}" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}" FontWeight="Bold" FontSize="13.5" />
                                    </Grid>
                                    <Slider Minimum="1024" Maximum="16384" TickFrequency="512" IsSnapToTickEnabled="True" Value="{Binding MemoryMb, UpdateSourceTrigger=PropertyChanged}" Foreground="{DynamicResource AccentTextBrush}" />
                                    <Border Background="{DynamicResource SubtleSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12,8" Margin="0,4,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,5">
                                                <TextBlock Text="{Binding SystemMemorySummary}" FontSize="11.5" Foreground="{DynamicResource TextBrush}" />
                                                <TextBlock Text="建议先使用 4,096 MB" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" />
                                            </Grid>
                                            <ProgressBar Height="5" Minimum="0" Maximum="100" Value="{Binding MemoryUsagePercent, Mode=OneWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel></Border>
                                <TextBlock Text="{Binding SettingsStatus}" Style="{StaticResource MutedText}" FontSize="12" Margin="2,10,0,4" />
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="LauncherSettingsPage" Style="{StaticResource PagePanel}">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Padding="22,20">
                                    <StackPanel>
                                        <TextBlock Text="外观主题" FontSize="17" FontWeight="SemiBold" />
                                        <UniformGrid Rows="1" Margin="0,16,0,0">
                                            <RadioButton x:Name="CherryThemeOption" GroupName="LauncherTheme" Tag="cherry" Click="Theme_Click"
                                                         AutomationProperties.Name="樱花主题" Style="{StaticResource RoomRoleTab}"
                                                         IsChecked="{Binding IsCherryTheme, Mode=OneWay}" HorizontalContentAlignment="Stretch" Margin="0,0,7,0">
                                                <StackPanel Margin="10,10,10,14">
                                                    <Grid>
                                                        <Border Height="120" CornerRadius="9">
                                                            <Border.Background><ImageBrush ImageSource="/MCL;component/Assets/spring-valley.jpg" Stretch="UniformToFill" /></Border.Background>
                                                        </Border>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="6"
                                                                Background="{DynamicResource AccentBrush}" Visibility="{Binding IsCherryTheme, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="当前使用" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="樱花" FontSize="14.5" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="AmethystThemeOption" GroupName="LauncherTheme" Tag="amethyst" Click="Theme_Click"
                                                         AutomationProperties.Name="紫水晶洞穴主题" Style="{StaticResource RoomRoleTab}"
                                                         IsChecked="{Binding IsAmethystTheme, Mode=OneWay}" HorizontalContentAlignment="Stretch" Margin="7,0,0,0">
                                                <StackPanel Margin="10,10,10,14">
                                                    <Grid>
                                                        <Border Height="120" CornerRadius="9">
                                                            <Border.Background><ImageBrush ImageSource="/MCL;component/Assets/amethyst-geode.jpg" Stretch="UniformToFill" /></Border.Background>
                                                        </Border>
                                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Padding="8,3" CornerRadius="6"
                                                                Background="{DynamicResource AccentBrush}" Visibility="{Binding IsAmethystTheme, Converter={StaticResource BoolVisibility}}">
                                                            <TextBlock Text="当前使用" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="紫水晶洞穴" FontSize="14.5" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}" Padding="22,16" Margin="0,14,0,0">
                                    <DockPanel>
                                        <CheckBox x:Name="ReduceMotionOption" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}"
                                                  Click="ReduceMotion_Click" IsChecked="{Binding ReduceMotion, Mode=OneWay}"
                                                  VerticalAlignment="Center" AutomationProperties.Name="减少动画"
                                                  ToolTip="减少主题切换、页面切换与插画过渡的动画。" />
                                        <Label Target="{Binding ElementName=ReduceMotionOption}" Content="减少动画" FontSize="14.5" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextBrush}" Padding="0" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <Grid x:Name="LogsPage" Style="{StaticResource PagePanel}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,14" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="复制日志" Click="CopyLogs_Click" />
                                <Button Content="打开日志文件夹" Margin="9,0,0,0" Click="OpenLogs_Click" />
                            </StackPanel>
                            <Border Grid.Row="1" Background="{DynamicResource LogBackgroundBrush}" CornerRadius="14" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14">
                                <ListBox x:Name="LogList" ItemsSource="{Binding Logs}" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter Margin="0,3.5" /></ControlTemplate></Setter.Value></Setter></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="55" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding TimeText}" FontFamily="Consolas" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" /><TextBlock Grid.Column="1" Text="{Binding Level}" FontFamily="Consolas" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" /><TextBlock Grid.Column="2" Text="{Binding Message}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource LogTextBrush}" /></Grid></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Grid>
                    </Grid>
                </ScrollViewer>
                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource Card}" Background="{DynamicResource HeroBrush}" Padding="12,8" Margin="0,8,6,0"
                            Visibility="{Binding ShowLaunchProblem, Converter={StaticResource BoolVisibility}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="关闭" Padding="9,5" Click="DismissLaunchProblem_Click" Margin="7,0,0,0" />
                            <Button DockPanel.Dock="Right" Content="{Binding LaunchProblemAction}" Padding="10,5" Margin="10,0,0,0"
                                    Click="LaunchProblemAction_Click" IsEnabled="{Binding CanInteract}" />
                            <TextBlock Text="{Binding LaunchProblemText}" Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="78" ToolTip="{Binding LaunchProblemText}" />
                        </DockPanel>
                    </Border>
                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,10,6,0" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,15,0" VerticalAlignment="Center" />
                            <Button x:Name="FooterSaveButton" Grid.Column="1" Content="保存设置" Visibility="Collapsed" Style="{StaticResource PrimaryButton}"
                                    Padding="18,9" Click="SaveSettings_Click" IsEnabled="{Binding CanInteract}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
        <Image x:Name="ThemeRevealLayer" Grid.ColumnSpan="2" Panel.ZIndex="10" Stretch="Fill"
               IsHitTestVisible="False" Focusable="False" />
    </Grid>
</Window>
